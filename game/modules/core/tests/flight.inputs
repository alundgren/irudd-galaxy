widget = "point:640,560"
[[note]]
tick = 300
text = "Docking at Lantern Dock; the traders fly on."
[[note]]
tick = 440
text = "Docked: the station up close."
[[note]]
tick = 482
text = "W flew the ship straight off the dock, facing away from the station."
[[note]]
tick = 494
