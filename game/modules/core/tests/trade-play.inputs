# The trade loop by real clicks at the design size: Kiln ore and plate, the galley site,
# a quick redock tap, two more plate runs until the galley is built, Ines's introduction,
# her gift of a ration taken, rations bought at the galley and sold at the Kiln.
# Rooms glide open, so a click after opening or leaving one waits for the glide. 12 notes.

# The flights between are scripted Mine and Dock orders, which fly themselves;
# hand-mining.inputs flies them by hand.
[[input]]
tick = 1
name = "core.ahead"
payload = { down = true }

[[input]]
tick = 11
name = "core.ahead"
payload = { down = false }

[[input]]
tick = 60
name = "core.mine"

[[input]]
tick = 330
name = "core.dock"
payload = { station = "core.kiln" }

[[click]]
tick = 715
widget = "sign_exchange"

[[note]]
tick = 723
text = "Kiln exchange: a full hold of ore; buying plate rests until I sell."

[[click]]
tick = 748
widget = "sell_ore"

[[click]]
tick = 763
widget = "buymax_plate"

[[note]]
tick = 771
text = "Sold the ore, bought plate; each unit of plate asked a little more."

[[click]]
tick = 786
widget = "close"

[[click]]
tick = 819
widget = "launch"

[[input]]
tick = 859
name = "core.dock"
payload = { station = "core.lantern" }

[[click]]
tick = 1204
widget = "sign_galley"

[[note]]
tick = 1212
text = "Lantern Dock: the galley site, 0 of 10 plate in."

[[click]]
tick = 1237
widget = "close"

[[click]]
tick = 1270
widget = "sign_exchange"

[[click]]
tick = 1303
widget = "sell_plate"

[[note]]
tick = 1311
text = "Plate sold into the galley: 3 of 10."

[[click]]
tick = 1326
widget = "close"

[[click]]
tick = 1359
widget = "launch"

[[input]]
tick = 1399
name = "core.dock"
payload = { station = "core.lantern" }

[[note]]
tick = 1549
text = "A quick undock and redock: still one visit, nothing restocked."

[[click]]
tick = 1564
widget = "launch"

[[input]]
tick = 1604
name = "core.dock"
payload = { station = "core.kiln" }

[[click]]
tick = 1949
widget = "sign_exchange"

[[click]]
tick = 1982
widget = "buymax_plate"

[[click]]
tick = 1997
widget = "close"

[[click]]
tick = 2030
widget = "launch"

[[input]]
tick = 2070
name = "core.dock"
payload = { station = "core.lantern" }

[[click]]
tick = 2415
widget = "sign_exchange"

[[click]]
tick = 2448
widget = "sell_plate"

[[click]]
tick = 2463
widget = "close"

[[click]]
tick = 2496
widget = "launch"

[[input]]
tick = 2536
name = "core.dock"
payload = { station = "core.kiln" }

[[click]]
tick = 2881
widget = "sign_exchange"

[[click]]
tick = 2914
widget = "buymax_plate"

[[click]]
tick = 2929
widget = "close"

[[click]]
tick = 2962
widget = "launch"

[[input]]
tick = 3002
name = "core.dock"
payload = { station = "core.lantern" }

[[click]]
tick = 3347
widget = "sign_exchange"

[[click]]
tick = 3380
widget = "sell_plate"

[[note]]
tick = 3388
text = "The tenth plate: the galley is built."

[[click]]
tick = 3403
widget = "close"

[[note]]
tick = 3411
text = "The station has grown: the galley stands where the scaffold was, with Ines by it."

[[click]]
tick = 3436
widget = "sign_galley"

[[click]]
tick = 3469
widget = "speaker.core.lantern_cook"

[[note]]
tick = 3477
text = "Ines introduces herself."

[[click]]
tick = 3492
widget = "talk.core.lantern_cook_intro"

[[click]]
tick = 3507
widget = "talk.core.lantern_cook_intro"

[[click]]
tick = 3522
widget = "talk.core.lantern_cook_intro"

# Once she's introduced, Ines offers a ration for the plate, once; take it.
[[click]]
tick = 3537
widget = "speaker.core.lantern_cook"
[[click]]
tick = 3552
widget = "talk.core.lantern_cook_gift"
[[note]]
tick = 3560
text = "Ines offers a ration on the house, with Take it and No, thanks."
[[click]]
tick = 3567
widget = "choice.core.lantern_cook_gift_take"
[[click]]
tick = 3582
widget = "talk.core.lantern_cook_gift"
[[click]]
tick = 3597
widget = "buymax_rations"

[[note]]
tick = 3605
text = "Bought rations at the galley."

[[click]]
tick = 3620
widget = "close"

[[click]]
tick = 3653
widget = "log_open"

[[note]]
tick = 3661
text = "The log: sales, the galley built, the conversation."

[[click]]
tick = 3676
widget = "log_close"

[[click]]
tick = 3691
widget = "launch"

[[input]]
