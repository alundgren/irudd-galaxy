# The trade loop by real clicks at the design size: Kiln ore and plate, the galley site,
# a quick redock tap, two more plate runs until the galley is built, Ines's introduction,
# her gift of a ration taken, rations bought at the galley and sold at the Kiln.
# Rooms glide open, so a click after opening or leaving one waits for the glide. 12 notes.

# The flights between are scripted Mine and Dock orders, which fly themselves;
# hand-mining.inputs flies them by hand.
[[input]]
tick = 1
name = "core.ahead"
payload = { down = true }

[[input]]
tick = 11
name = "core.ahead"
payload = { down = false }

[[input]]
tick = 60
name = "core.mine"

[[input]]
tick = 900
name = "core.dock"
payload = { station = "core.kiln" }

[[click]]
tick = 2091
widget = "sign_exchange"

[[note]]
tick = 2099
text = "Kiln exchange: a full hold of ore; buying plate rests until I sell."

[[click]]
tick = 2124
widget = "sell_ore"

[[click]]
tick = 2139
widget = "buymax_plate"

[[note]]
tick = 2147
text = "Sold the ore, bought plate; each unit of plate asked a little more."

[[click]]
tick = 2162
widget = "close"

[[click]]
tick = 2195
widget = "launch"

[[input]]
tick = 2235
name = "core.dock"
payload = { station = "core.lantern" }

[[click]]
tick = 3536
widget = "sign_galley"

[[note]]
tick = 3544
text = "Lantern Dock: the galley site, 0 of 40 plate in."

[[click]]
tick = 3569
widget = "close"

[[click]]
tick = 3602
widget = "sign_exchange"

[[click]]
tick = 3635
widget = "sell_plate"

[[note]]
tick = 3643
text = "Plate sold into the galley: 13 of 40."

[[click]]
tick = 3658
widget = "close"

[[click]]
tick = 3691
widget = "launch"

[[input]]
tick = 3731
name = "core.dock"
payload = { station = "core.lantern" }

[[note]]
tick = 3881
text = "A quick undock and redock: still one visit, nothing restocked."

[[click]]
tick = 3896
widget = "launch"

[[input]]
tick = 3936
name = "core.dock"
payload = { station = "core.kiln" }

[[click]]
tick = 5234
widget = "sign_exchange"

[[click]]
tick = 5267
widget = "buymax_plate"

[[click]]
tick = 5282
widget = "close"

[[click]]
tick = 5315
widget = "launch"

[[input]]
tick = 5355
name = "core.dock"
payload = { station = "core.lantern" }

[[click]]
tick = 6656
widget = "sign_exchange"

[[click]]
tick = 6689
widget = "sell_plate"

[[click]]
tick = 6704
widget = "close"

[[click]]
tick = 6737
widget = "launch"

[[input]]
tick = 6777
name = "core.dock"
payload = { station = "core.kiln" }

[[click]]
tick = 8075
widget = "sign_exchange"

[[click]]
tick = 8108
widget = "buymax_plate"

[[click]]
tick = 8123
widget = "close"

[[click]]
tick = 8156
widget = "launch"

[[input]]
tick = 8196
name = "core.dock"
payload = { station = "core.lantern" }

[[click]]
tick = 9497
widget = "sign_exchange"

[[click]]
tick = 9530
widget = "sell_plate"

[[note]]
tick = 9538
text = "The fortieth plate: the galley is built."

[[click]]
tick = 9553
widget = "close"

[[note]]
tick = 9561
text = "The station has grown: the galley stands where the scaffold was, with Ines by it."

[[click]]
tick = 9586
widget = "sign_galley"

[[click]]
tick = 9619
widget = "speaker.core.lantern_cook"

[[note]]
tick = 9627
text = "Ines introduces herself."

[[click]]
tick = 9642
widget = "talk.core.lantern_cook_intro"

[[click]]
tick = 9657
widget = "talk.core.lantern_cook_intro"

[[click]]
tick = 9672
widget = "talk.core.lantern_cook_intro"

# Once she's introduced, Ines offers a ration for the plate, once; take it.
[[click]]
tick = 9687
widget = "speaker.core.lantern_cook"
[[click]]
tick = 9702
widget = "talk.core.lantern_cook_gift"
[[note]]
tick = 9710
text = "Ines offers a ration on the house, with Take it and No, thanks."
[[click]]
tick = 9717
widget = "choice.core.lantern_cook_gift_take"
[[click]]
tick = 9732
widget = "talk.core.lantern_cook_gift"
[[click]]
tick = 9747
widget = "buymax_rations"

[[note]]
tick = 9755
text = "Bought rations at the galley."

[[click]]
tick = 9770
widget = "close"

[[click]]
tick = 9803
widget = "log_open"

[[note]]
tick = 9811
text = "The log: sales, the galley built, the conversation."

[[click]]
tick = 9826
widget = "log_close"

[[click]]
tick = 9841
widget = "launch"

[[input]]
tick = 9881
name = "core.dock"
payload = { station = "core.kiln" }

[[click]]
tick = 11179
widget = "sign_exchange"

[[click]]
tick = 11212
widget = "sell_rations"

[[note]]
tick = 11220
text = "Rations sold to the Kiln crews."
