# The trade loop by real clicks at the design size: Kiln ore and plate, the galley site,
# Ines's introduction at the bare site, a quick redock tap, two more plate runs until the
# galley is built, her gift of a ration taken, rations bought at the galley and sold at
# the Kiln.
# Rooms glide open, so a click after opening or leaving one waits for the glide. 12 notes.
# (back-talk.inputs and the routes after it meet her only once the galley stands.)

# The flights between are scripted Mine and Dock orders, which fly themselves;
# hand-mining.inputs flies them by hand.
[[input]]
tick = 1
name = "core.ahead"
payload = { down = true }

[[input]]
tick = 11
name = "core.ahead"
payload = { down = false }

[[input]]
tick = 60
name = "core.mine"

[[input]]
tick = 960
name = "core.dock"
payload = { station = "core.kiln" }

[[click]]
tick = 1852
widget = "sign_exchange"

[[note]]
tick = 1860
text = "Kiln exchange: a full hold of ore; buying plate rests until I sell."

[[click]]
tick = 1885
widget = "sell_ore"

[[click]]
tick = 1900
widget = "buymax_plate"

[[note]]
tick = 1908
text = "Sold the ore, bought plate; each unit of plate asked a little more."

[[click]]
tick = 1923
widget = "close"

[[click]]
tick = 1956
widget = "launch"

[[input]]
tick = 1996
name = "core.dock"
payload = { station = "core.lantern" }

[[click]]
tick = 2882
widget = "sign_galley"

[[note]]
tick = 2890
text = "Lantern Dock: the galley site, 0 of 40 plate in, and Ines waiting in it."

[[click]]
tick = 2915
widget = "speaker.core.lantern_cook"

[[note]]
tick = 2923
text = "Ines introduces herself at the bare site: why she wants the galley."

[[click]]
tick = 2938
widget = "talk.core.lantern_cook_intro"

[[click]]
tick = 2953
widget = "talk.core.lantern_cook_intro"

[[click]]
tick = 2968
widget = "talk.core.lantern_cook_intro"

[[click]]
tick = 2985
widget = "close"

[[click]]
tick = 3018
widget = "sign_exchange"

[[click]]
tick = 3051
widget = "sell_plate"

[[note]]
tick = 3059
text = "Plate sold into the galley: 13 of 40."

[[click]]
tick = 3074
widget = "close"

[[click]]
tick = 3107
widget = "launch"

[[input]]
tick = 3147
name = "core.dock"
payload = { station = "core.lantern" }

[[note]]
tick = 3297
text = "A quick undock and redock: still one visit, nothing restocked."

[[click]]
tick = 3312
widget = "launch"

[[input]]
tick = 3352
name = "core.dock"
payload = { station = "core.kiln" }

[[click]]
tick = 4235
widget = "sign_exchange"

[[click]]
tick = 4268
widget = "buymax_plate"

[[click]]
tick = 4283
widget = "close"

[[click]]
tick = 4316
widget = "launch"

[[input]]
tick = 4356
name = "core.dock"
payload = { station = "core.lantern" }

[[click]]
tick = 5242
widget = "sign_exchange"

[[click]]
tick = 5275
widget = "sell_plate"

[[click]]
tick = 5290
widget = "close"

[[click]]
tick = 5323
widget = "launch"

[[input]]
tick = 5363
name = "core.dock"
payload = { station = "core.kiln" }

[[click]]
