# The trade loop by real clicks at the design size: Kiln ore and plate, the galley site,
# Ines's introduction at the bare site, a quick redock tap, two more plate runs until the
# galley is built, her gift of a ration taken, rations bought at the galley and sold at
# the Kiln.
# Rooms glide open, so a click after opening or leaving one waits for the glide. 12 notes.
# (back-talk.inputs and the routes after it meet her only once the galley stands.)

# The flights between are scripted Mine and Dock orders, which fly themselves;
# hand-mining.inputs flies them by hand.
[[input]]
tick = 1
name = "core.ahead"
payload = { down = true }

[[input]]
tick = 11
name = "core.ahead"
payload = { down = false }

[[input]]
tick = 60
name = "core.mine"

[[input]]
tick = 960
name = "core.dock"
payload = { station = "core.kiln" }

[[click]]
tick = 1852
widget = "sign_exchange"

[[note]]
tick = 1860
text = "Kiln exchange: a full hold of ore; buying plate rests until I sell."

[[click]]
tick = 1885
widget = "sell_ore"

[[click]]
tick = 1900
widget = "buymax_plate"

[[note]]
tick = 1908
text = "Sold the ore, bought plate; each unit of plate asked a little more."

[[click]]
tick = 1923
widget = "close"

[[click]]
tick = 1956
widget = "launch"

[[input]]
tick = 1996
name = "core.dock"
payload = { station = "core.lantern" }

[[click]]
tick = 2882
widget = "sign_galley"

[[note]]
tick = 2890
text = "Lantern Dock: the galley site, 0 of 40 plate in, and Ines waiting in it."

[[click]]
tick = 2905
widget = "speaker.core.lantern_cook"

[[note]]
tick = 2913
text = "Ines introduces herself at the bare site: why she wants the galley."

[[click]]
tick = 2928
widget = "talk.core.lantern_cook_intro"

[[click]]
tick = 2943
widget = "talk.core.lantern_cook_intro"

[[click]]
tick = 2958
widget = "talk.core.lantern_cook_intro"

[[click]]
tick = 2975
widget = "close"

[[click]]
tick = 3008
widget = "sign_exchange"

[[click]]
tick = 3041
widget = "sell_plate"

[[note]]
tick = 3049
text = "Plate sold into the galley: 13 of 40."

[[click]]
tick = 3064
widget = "close"

[[click]]
tick = 3097
widget = "launch"

[[input]]
tick = 3137
name = "core.dock"
payload = { station = "core.lantern" }

[[note]]
tick = 3287
text = "A quick undock and redock: still one visit, nothing restocked."

[[click]]
tick = 3302
widget = "launch"

[[input]]
tick = 3342
name = "core.dock"
payload = { station = "core.kiln" }

[[click]]
tick = 4225
widget = "sign_exchange"

[[click]]
tick = 4258
widget = "buymax_plate"

[[click]]
tick = 4273
widget = "close"

[[click]]
tick = 4306
widget = "launch"

[[input]]
tick = 4346
name = "core.dock"
payload = { station = "core.lantern" }

[[click]]
tick = 5232
widget = "sign_exchange"

[[click]]
tick = 5265
widget = "sell_plate"

[[click]]
tick = 5280
widget = "close"

[[click]]
tick = 5313
widget = "launch"

[[input]]
tick = 5353
name = "core.dock"
payload = { station = "core.kiln" }

[[click]]
tick = 6236
widget = "sign_exchange"

[[click]]
tick = 6269
widget = "buymax_plate"

[[click]]
tick = 6284
widget = "close"

[[click]]
tick = 6317
widget = "launch"

[[input]]
tick = 6357
name = "core.dock"
payload = { station = "core.lantern" }

[[click]]
tick = 7243
widget = "sign_exchange"

[[click]]
tick = 7276
widget = "sell_plate"

[[note]]
tick = 7284
text = "The fortieth plate: the galley is built."

[[click]]
tick = 7299
widget = "close"

[[note]]
tick = 7307
text = "The station has grown: the galley stands where the scaffold was, with Ines by it."

[[click]]
tick = 7332
widget = "sign_galley"

# Met before, Ines offers a ration for the plate at the first click, once; take it.
[[click]]
tick = 7433
widget = "speaker.core.lantern_cook"
[[click]]
tick = 7448
widget = "talk.core.lantern_cook_gift"
[[note]]
tick = 7456
text = "Ines offers a ration on the house, with Take it and No, thanks."
[[click]]
tick = 7463
widget = "choice.core.lantern_cook_gift_take"
[[click]]
tick = 7478
widget = "talk.core.lantern_cook_gift"
[[click]]
tick = 7493
widget = "buymax_rations"

[[note]]
tick = 7501
text = "Bought rations at the galley."

[[click]]
tick = 7516
widget = "close"

[[click]]
tick = 7549
widget = "log_open"

[[note]]
