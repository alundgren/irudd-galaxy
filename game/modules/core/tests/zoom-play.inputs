# Trader labels at every zoom, by the scroll wheel: zoomed fully in, the ship flies south
# across Little Mercy's lane as she comes along it from Lantern Dock, so her label yields
# while it would sit on the HUD and is drawn once she is beside the ship; then zoomed
# fully out, where she is named, and off Cinder Kiln, where she and Quiet Lamp lie moored
# without labels. Six notes.
#
# The state between is set by edits: once Mercy is under way, she and the ship are set
# where the route out to her lane brings them; later the ship is set just off Cinder
# Kiln's berth, and both traders moored off the Kiln.
[[input]]
tick = 1
name = "core.right"
payload = { down = true }
[[zoom]]
tick = 10
steps = 20.0
[[input]]
tick = 16
name = "core.right"
payload = { down = false }
[[edit]]
tick = 200
entity = "core.mercy"
component = "engine.position"
set = { x = -33.52, y = -249.26 }
[[edit]]
tick = 200
entity = "core.ship"
component = "engine.position"
set = { x = 0.0, y = -185.67, angle = -1.5707963267948966 }
[[edit]]
tick = 200
entity = "core.ship"
component = "engine.motion"
set = { vx = 0.0, vy = -20.0 }
[[input]]
tick = 200
name = "core.ahead"
payload = { down = true }
[[note]]
tick = 201
text = "Zoomed fully in: Little Mercy is still off screen, so no label of hers is drawn."
[[note]]
tick = 280
text = "Zoomed in, she passes below the ship: her label would sit on the message, so it yields."
[[note]]
tick = 296
text = "Zoomed in, she is beside the ship: named, clear of the orders, status and message."
[[input]]
tick = 320
name = "core.ahead"
payload = { down = false }
[[zoom]]
tick = 340
steps = -40.0
[[note]]
tick = 380
text = "Zoomed fully out: Little Mercy named as she flies on towards Cinder Kiln."
