# Going back while someone is speaking, in the 1024x576 window: the trade route by real
# clicks until Ines offers her gift, then Esc with the offer unanswered; back in, her
# offer again from its first line, and a right-click on that ordinary line; then in
# once more to take the gift. On the whole station, the log opened while Tova speaks,
# and her exchange opened while she speaks. No bubble or sign may cover the HUD or a
# panel. Rooms glide open, so a click after opening or leaving one waits for the glide.

# The flights between are scripted Mine and Dock orders, which fly themselves;
# hand-mining.inputs flies them by hand.
[[input]]
tick = 1
name = "core.ahead"
payload = { down = true }

[[input]]
tick = 11
name = "core.ahead"
payload = { down = false }

[[input]]
tick = 60
name = "core.mine"

[[input]]
tick = 960
name = "core.dock"
payload = { station = "core.kiln" }

[[click]]
tick = 1852
widget = "sign_exchange"

[[note]]
tick = 1860
text = "Kiln exchange: a full hold of ore; buying plate rests until I sell."

[[click]]
tick = 1885
widget = "sell_ore"

[[click]]
tick = 1900
widget = "buymax_plate"

[[note]]
tick = 1908
text = "Sold the ore, bought plate; each unit of plate asked a little more."

[[click]]
tick = 1923
widget = "close"

[[click]]
tick = 1956
widget = "launch"

[[input]]
tick = 1996
name = "core.dock"
payload = { station = "core.lantern" }

[[click]]
tick = 2882
widget = "sign_galley"

[[note]]
tick = 2890
text = "Lantern Dock: the galley site, 0 of 40 plate in, and Ines waiting in it."

[[click]]
tick = 2915
widget = "close"

[[click]]
tick = 2948
widget = "sign_exchange"

[[click]]
tick = 2981
widget = "sell_plate"

[[note]]
tick = 2989
text = "Plate sold into the galley: 13 of 40."

[[click]]
tick = 3004
widget = "close"

[[click]]
tick = 3037
widget = "launch"

[[input]]
tick = 3077
name = "core.dock"
payload = { station = "core.lantern" }

[[note]]
tick = 3227
text = "A quick undock and redock: still one visit, nothing restocked."

[[click]]
tick = 3242
widget = "launch"

[[input]]
tick = 3282
name = "core.dock"
payload = { station = "core.kiln" }

[[click]]
tick = 4165
widget = "sign_exchange"

[[click]]
tick = 4198
widget = "buymax_plate"

[[click]]
tick = 4213
widget = "close"

[[click]]
tick = 4246
widget = "launch"

[[input]]
tick = 4286
name = "core.dock"
payload = { station = "core.lantern" }

[[click]]
tick = 5172
widget = "sign_exchange"

[[click]]
tick = 5205
widget = "sell_plate"

[[click]]
tick = 5220
widget = "close"

[[click]]
tick = 5253
widget = "launch"

[[input]]
tick = 5293
name = "core.dock"
payload = { station = "core.kiln" }

[[click]]
tick = 6176
widget = "sign_exchange"

[[click]]
tick = 6209
widget = "buymax_plate"

[[click]]
tick = 6224
widget = "close"

[[click]]
tick = 6257
widget = "launch"

[[input]]
tick = 6297
name = "core.dock"
payload = { station = "core.lantern" }

[[click]]
tick = 7183
widget = "sign_exchange"

[[click]]
tick = 7216
widget = "sell_plate"

[[note]]
tick = 7224
text = "The fortieth plate: the galley is built."

[[click]]
tick = 7239
widget = "close"

[[note]]
tick = 7247
text = "The station has grown: the galley stands where the scaffold was, with Ines by it."

[[click]]
tick = 7272
widget = "sign_galley"

[[click]]
tick = 7305
widget = "speaker.core.lantern_cook"

[[note]]
tick = 7313
text = "Ines introduces herself."

[[click]]
tick = 7328
widget = "talk.core.lantern_cook_intro"

[[click]]
tick = 7343
widget = "talk.core.lantern_cook_intro"

[[click]]
tick = 7358
widget = "talk.core.lantern_cook_intro"

[[click]]
tick = 7373
widget = "speaker.core.lantern_cook"
[[click]]
tick = 7388
widget = "talk.core.lantern_cook_gift"

# Back with the offer unanswered: Esc.
[[key]]
tick = 7403
key = "escape"
[[note]]
tick = 7408
text = "Back from Ines's unanswered offer: the bubble goes, the HUD shows."

# In again: her offer, still open, begins at its first line; Back on that line: a
# right-click.
[[click]]
tick = 7436
widget = "key_galley"
[[click]]
tick = 7469
widget = "speaker.core.lantern_cook"
[[key]]
tick = 7484
key = "mouse_right"
[[note]]
tick = 7489
text = "Back from her first line: the bubble goes again."

# In once more, and take it this time.
[[click]]
tick = 7517
widget = "key_galley"
[[click]]
tick = 7550
widget = "speaker.core.lantern_cook"
[[click]]
tick = 7565
widget = "talk.core.lantern_cook_gift"
[[click]]
tick = 7580
widget = "choice.core.lantern_cook_gift_take"
[[click]]
tick = 7595
widget = "talk.core.lantern_cook_gift"
[[note]]
tick = 7603
text = "The gift taken after all: one ration in the hold."
[[click]]
tick = 7610
widget = "close"

# In the exchange: Tova's line, then B cuts back out to the station, which ends it.
[[click]]
tick = 7646
widget = "key_exchange"
[[click]]
tick = 7686
widget = "speaker.core.lantern_trader"
[[key]]
tick = 7701
key = "b"
[[note]]
tick = 7710
text = "Going back out while Tova spoke ended her bubble."

# In again: a click on Tova begins a conversation afresh.
[[click]]
tick = 7741
widget = "key_exchange"
[[click]]
tick = 7781
widget = "speaker.core.lantern_trader"
[[note]]
tick = 7798
text = "Back in the exchange, Tova speaks again at a click."
