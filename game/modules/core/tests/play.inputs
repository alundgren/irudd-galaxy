# One shift by real clicks: mine, dock (the view glides in), hear Bram, point at the
# exchange (it lifts and outlines) and click it (the view glides to it), hear Tova,
# sell, go back with Esc, open the office and land its glide with a click, go back
# with a right-click, open the log and shut it with Esc, launch. 12 notes.
[[input]]
tick = 1
name = "core.ahead"
payload = { down = true }
[[input]]
tick = 11
name = "core.ahead"
payload = { down = false }
[[click]]
tick = 60
widget = "mine"
[[click]]
tick = 330
widget = "lantern"

# Bram introduces himself, one line per click on his bubble.
[[click]]
tick = 510
widget = "speaker.core.lantern_master"
[[click]]
tick = 530
widget = "talk.core.lantern_master_intro"
[[click]]
tick = 545
widget = "talk.core.lantern_master_intro"
[[click]]
tick = 560
widget = "talk.core.lantern_master_intro"
[[click]]
tick = 575
widget = "talk.core.lantern_master_intro"
[[click]]
tick = 590
widget = "talk.core.lantern_master_intro"

# The exchange building itself: hover, then click.
[[pointer]]
tick = 600
action = "move"
widget = "target_exchange"
[[click]]
tick = 610
widget = "target_exchange"

# Tova at the exchange: her introduction, then a line about the hold.
[[click]]
tick = 645
widget = "speaker.core.lantern_trader"
[[click]]
tick = 660
widget = "talk.core.lantern_trader_intro"
[[click]]
tick = 675
widget = "talk.core.lantern_trader_intro"
[[click]]
tick = 690
widget = "talk.core.lantern_trader_intro"
[[click]]
tick = 705
widget = "speaker.core.lantern_trader"
[[click]]
tick = 725
widget = "talk.core.lantern_trader_talk"
[[click]]
tick = 740
widget = "sell_ore"

# Back with Esc; the office from the key, its glide landed by a click; back with a
# right-click.
[[key]]
tick = 765
key = "escape"
[[click]]
tick = 800
widget = "key_office"
[[click]]
tick = 806
widget = "point:640,140"
[[key]]
tick = 830
key = "mouse_right"

# The log, shut with Esc; then launch.
[[click]]
tick = 865
widget = "log_open"
[[key]]
tick = 890
key = "escape"
[[click]]
tick = 905
widget = "launch"

[[note]]
tick = 30
text = "Flying into solid ironstone."
[[note]]
tick = 300
text = "Six ore aboard and a visible cut in the rock."
[[note]]
tick = 500
text = "Docked: the station up close, keepers wear name signs."
[[note]]
tick = 520
text = "Bram's first line: his name as a heading, his job quieter, one sentence, a small Continue."
[[note]]
tick = 603
text = "Pointing at the exchange: it lifts, gets an outline and the pointer is a hand."
[[note]]
tick = 620
text = "Clicked the exchange: the view glides to it as its room opens."
[[note]]
tick = 652
text = "Tova introduces herself beside the open exchange."
[[note]]
tick = 715
text = "Clicked again, Tova talks about the hold instead of repeating."
[[note]]
tick = 755
text = "Sold six ore; the stockpile and credits grew."
[[note]]
tick = 810
text = "The office glide landed at once on a click."
[[note]]
tick = 875
text = "The log: newest first, each conversation one entry with speaker and station."
[[note]]
tick = 980
text = "Launched back into space."
