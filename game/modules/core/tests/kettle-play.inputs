# Cold Kettle adrift by real clicks (kettle.bot.toml): greenhouse-play.inputs' route through
# Ines's greenhouse, then Noor's ask accepted, a hand flight out to the barge and a line
# passed with a click on her, a hand swing round the ice that slips it, the flights home
# scripted, her mooring and her plate handed over with Bram's gold button, two trips out
# and back, and the payoff: supper on the deck, the beds in bloom, Noor's thanks.
# The trade loop by real clicks at the design size: Kiln ore and plate, the galley site,
# a quick redock tap, two more plate runs until the galley is built, Ines's introduction,
# her gift of a ration taken, rations bought at the galley and sold at the Kiln.
# Rooms glide open, so a click after opening or leaving one waits for the glide. 12 notes.

# The flights between are scripted Mine and Dock orders, which fly themselves;
# hand-mining.inputs flies them by hand.
[[input]]
tick = 1
name = "core.ahead"
payload = { down = true }

