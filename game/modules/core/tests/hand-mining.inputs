# A hold mined and docked by hand, with the keys a player presses (hand-mining.toml is
# the same route headless). W flies up to the first rock; Space held puts the beam on
# it, chips fly back up the beam to the nose, each unit lands in the hold with an amber
# puff and a count, and the sixth fills it. Turned onto Lantern Dock's berth, W let go
# coasts the ship to a stop in its glowing ring and the clamps take her in with a puff.
# Flown off with W, a click on a far rock says it is out of reach. Eight notes.
[[input]]
tick = 4
name = "core.ahead"
source = "keyboard"
payload = { down = true }
[[input]]
tick = 13
name = "core.ahead"
source = "keyboard"
payload = { down = false }
