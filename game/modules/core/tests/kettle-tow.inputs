component = "engine.motion"
set = { vx = 0, vy = 0 }
[[note]]
tick = 555
text = "Cold Kettle lies dark in the ice, a flare going up. I'm alongside and at rest."
# A click on her passes the line.
[[click]]
tick = 560
widget = "hover_kettle"
[[note]]
tick = 580
text = "A line across: the tow line runs from her bow."
# Set as a taut line leaves them, then hard round to the right among the floes, a check
