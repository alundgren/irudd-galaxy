# Trade and log by real clicks, from set states (trade-click.bot.toml): the galley site and
# Ines's introduction at it, plate sold into the galley with the exchange's Sell button,
# the fortieth plate building it, her gift taken by its answer button, rations bought with
# Buy max, the log opened and shut, and rations sold at Cinder Kiln with their Sell
# button. trade.toml checks the same trade as events; this route is the clicks.
# Rooms glide open, so a click after opening or leaving one waits for the glide.
#
# Starts just off Lantern Dock's berth with 13 plate aboard; once that is sold, one plate
# is set aboard with 39 already given, so the next sale builds the galley.

[[edit]]
entity = "core.ship"
component = "core.hold"
set = { plate = 13 }

[[edit]]
entity = "core.ship"
component = "engine.position"
set = { x = -178, y = -197 }

[[input]]
tick = 1
name = "core.dock"
source = "script"
payload = { station = "core.lantern" }

[[click]]
tick = 135
widget = "sign_galley"

[[note]]
tick = 143
text = "Lantern Dock: the galley site, 0 of 40 plate in, and Ines waiting in it."

[[click]]
tick = 168
widget = "speaker.core.lantern_cook"

[[click]]
tick = 183
widget = "talk.core.lantern_cook_intro"

[[click]]
tick = 198
widget = "talk.core.lantern_cook_intro"

[[click]]
tick = 213
widget = "talk.core.lantern_cook_intro"

[[click]]
tick = 230
widget = "close"

[[click]]
tick = 263
widget = "sign_exchange"

[[click]]
tick = 296
widget = "sell_plate"

[[note]]
tick = 304
text = "Plate sold into the galley: 13 of 40."

# One plate more aboard, with 39 given: the next sale is the fortieth.

[[edit]]
tick = 310
entity = "core.lantern_galley"
component = "core.build"
set = { given = 39 }

[[edit]]
tick = 310
entity = "core.ship"
component = "core.hold"
set = { plate = 1 }

[[click]]
tick = 320
widget = "sell_plate"

[[note]]
tick = 328
text = "The fortieth plate: the galley is built."

[[click]]
tick = 343
widget = "close"

[[click]]
tick = 376
widget = "sign_galley"

[[click]]
tick = 477
widget = "speaker.core.lantern_cook"

[[click]]
tick = 492
widget = "talk.core.lantern_cook_gift"

[[note]]
tick = 500
text = "Ines offers a ration on the house, with Take it and No, thanks."

[[click]]
tick = 507
widget = "choice.core.lantern_cook_gift_take"

[[click]]
tick = 522
widget = "talk.core.lantern_cook_gift"

[[click]]
tick = 537
widget = "buymax_rations"

[[note]]
tick = 545
text = "Bought rations at the galley."

[[click]]
tick = 560
widget = "close"

[[click]]
tick = 593
widget = "log_open"

[[note]]
tick = 601
text = "The log: sales, the galley built, the conversation."

[[click]]
tick = 616
widget = "log_close"

[[click]]
tick = 631
widget = "launch"

# Set just off Cinder Kiln's berth.

[[edit]]
tick = 671
entity = "core.ship"
component = "engine.position"
set = { x = 200, y = -249 }

[[edit]]
tick = 671
entity = "core.ship"
component = "engine.motion"
set = { vx = 0.0, vy = 0.0 }

[[input]]
tick = 672
name = "core.dock"
source = "script"
payload = { station = "core.kiln" }

[[click]]
tick = 800
widget = "sign_exchange"

[[click]]
tick = 833
widget = "sell_rations"

[[note]]
tick = 841
text = "Rations sold to the Kiln crews."
