# Ines's greenhouse by real clicks, from set states (greenhouse-click.bot.toml): her ask
# accepted, Sefa's introduction and the glassite handed over, the panes loaded, delivered
# to Ines, the thirtieth ice sold with the exchange's Sell button building the greenhouse,
# Ines's thanks and Noor's introduction, each talk advanced and answered through its own
# buttons. The greenhouse scenarios check the same steps as events; this route is the
# clicks. Rooms glide open, so a click after opening or leaving one waits for the glide.
#
# Starts just off Lantern Dock's berth with the fortieth plate aboard: docked, it is sold
# by events to build the galley, then Ines's gift is set answered and the galley lived in.
# Between the steps the ship is set just off the next berth (with 8 glassite for Sefa, a
# trip away so the panes are ready, and the greenhouse one ice short).

[[edit]]
entity = "core.lantern_galley"
component = "core.build"
set = { given = 39 }

[[edit]]
entity = "core.ship"
component = "core.hold"
set = { plate = 1 }

[[edit]]
entity = "core.ship"
component = "engine.position"
set = { x = -178, y = -197 }

[[input]]
tick = 1
name = "core.dock"
source = "script"
payload = { station = "core.lantern" }

[[input]]
tick = 100
name = "core.open"

[[input]]
tick = 110
name = "core.sell"

[[input]]
tick = 120
name = "core.close"

[[edit]]
tick = 125
entity = "core.lantern_galley"
component = "core.build"
set = { opened = 0 }

[[edit]]
tick = 125
entity = "core.lantern_cook_gift"
component = "core.gift"
set = { answered = true, taken = true }

# Ines introduces herself in her galley, then asks for a greenhouse; Accept.

[[click]]
tick = 160
widget = "key_galley"

[[click]]
tick = 193
widget = "speaker.core.lantern_cook"

[[click]]
tick = 208
widget = "talk.core.lantern_cook_intro"

[[click]]
tick = 223
widget = "talk.core.lantern_cook_intro"

[[click]]
tick = 238
widget = "talk.core.lantern_cook_intro"

[[click]]
tick = 253
widget = "speaker.core.lantern_cook"

[[click]]
tick = 268
widget = "talk.core.greenhouse_ask"

[[click]]
tick = 283
widget = "talk.core.greenhouse_ask"

[[click]]
tick = 298
widget = "talk.core.greenhouse_ask"

[[note]]
tick = 306
text = "Ines asks for a greenhouse, with Accept and Not now."

[[click]]
tick = 313
widget = "choice.core.greenhouse_ask_yes"

[[click]]
tick = 328
widget = "talk.core.greenhouse_ask"

[[click]]
tick = 343
widget = "close"

