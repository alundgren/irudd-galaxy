# The fitting loop by real clicks and drags at the design size: the cradle (three parts
# on the rack, priced), a part picked up that can't be paid for, the lens bought and
# fitted after the next sale, the thrusters refused for power while still held, Orrin's
# talk beside the panel, mining at two a second, hold pods fitted over the free mass, and
# the pods refused coming off while the bigger hold is full.
# At the exchange with a full hold, a click on the resting Buy 1 buys nothing.
# Rooms glide open, so a click after opening or leaving one waits for the glide.
#
# The state between is set by edits: the ship starts just off Cinder Kiln's berth with a
# hold of ore and 2,879 credits, one hold short of the lens; it is set beside rock5 to
# mine, given the pods' price, and set back off the berth with 36 aboard. The clicks and
# drags are this bot's: tests/fit.toml checks the same rules as events. The chart glass
# is already in, so Orrin's rack is open.
[[edit]]
entity = "core.chart"
component = "core.part"
set = { found = true, owned = true, fitted = true }

[[edit]]
entity = "core.ship"
component = "core.pilot"
set = { credits = 2879 }

[[edit]]
entity = "core.ship"
component = "core.hold"
set = { ore = 24 }

[[edit]]
entity = "core.ship"
component = "engine.position"
set = { x = 200, y = -249 }

[[input]]
tick = 1
name = "core.dock"
source = "script"
payload = { station = "core.kiln" }

[[click]]
tick = 128
widget = "sign_cradle"

[[note]]
tick = 178
text = "First visit to the cradle with 2879 cr, short of the lens: three parts on the rack with prices and numbers."

[[pointer]]
tick = 188
action = "pickup"
widget = "part_lens"

[[pointer]]
tick = 193
action = "move"
widget = "socket_drill"

[[note]]
tick = 198
text = "Holding the lens with 2879 cr: every socket says now why it can't go there."

[[pointer]]
tick = 208
action = "drop"
widget = "socket_drill"

[[click]]
tick = 238
widget = "close"

[[click]]
tick = 278
widget = "sign_exchange"

[[note]]
tick = 303
text = "Kiln exchange with a full hold: Buy 1 rests in place, with its reason beside it."

[[click]]
tick = 313
widget = "buy1_plate"

[[click]]
tick = 320
widget = "sell_ore"

[[click]]
tick = 338
widget = "close"

[[click]]
tick = 378
