widget = "talk.core.kiln_fitter_intro"

[[click]]
tick = 925
widget = "talk.core.kiln_fitter_intro"

[[click]]
tick = 940
widget = "talk.core.kiln_fitter_intro"

[[click]]
tick = 960
widget = "speaker.core.kiln_fitter"

[[note]]
tick = 970
text = "Orrin's line after the fit is flavour, not the receipt again."

[[click]]
tick = 980
widget = "talk.core.kiln_fitter_talk"

[[click]]
tick = 1000
widget = "close"

[[click]]
tick = 1040
widget = "launch"

