# The fitting loop by real clicks and drags at the design size: the cradle on a new
# game (three parts on the rack, priced), a part picked up that can't be paid for, the
# lens bought and fitted after the first sale, the thrusters refused for power while
# still held, Orrin's talk beside the panel, mining at two a second, hold pods fitted
# over the free mass, and the pods refused coming off while the bigger hold is full.
# At the exchange with a full hold, a click on the resting Buy 1 buys nothing.
# Rooms glide open, so a click after opening or leaving one waits for the glide.

# The flights between are scripted Mine and Dock orders, which fly themselves;
# hand-mining.inputs flies them by hand.
[[input]]
tick = 1
name = "core.ahead"
payload = { down = true }

[[input]]
tick = 11
name = "core.ahead"
payload = { down = false }

[[input]]
tick = 60
name = "core.mine"

[[input]]
tick = 330
name = "core.dock"
payload = { station = "core.kiln" }

[[click]]
tick = 480
widget = "sign_cradle"

[[note]]
tick = 530
text = "First visit to the cradle with 0 cr: three parts on the rack with prices and numbers."

[[pointer]]
tick = 540
action = "pickup"
widget = "part_lens"

[[pointer]]
tick = 545
action = "move"
widget = "empty_drill"

[[note]]
tick = 550
text = "Holding the lens with 0 cr: every socket says now why it can't go there."

[[pointer]]
tick = 560
action = "drop"
widget = "socket_drill"

[[click]]
tick = 590
widget = "close"

[[click]]
tick = 630
widget = "sign_exchange"

[[note]]
tick = 655
text = "Kiln exchange with a full hold: Buy 1 rests in place, with its reason beside it."

[[click]]
tick = 665
