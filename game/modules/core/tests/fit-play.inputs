# The fitting loop by real clicks and drags at the design size: ore runs until the lens
# is one hold away, then the cradle (three parts on the rack, priced), a part picked up
# that can't be paid for, the lens bought and fitted with the next sale, the thrusters
# refused for power while still held, Orrin's talk beside the panel, mining at two a
# second, more ore runs until the pods are paid for, hold pods fitted over the free
# mass, and the pods refused coming off while the bigger hold is full.
# At the exchange with a full hold, a click on the resting Buy 1 buys nothing.
# Rooms glide open, so a click after opening or leaving one waits for the glide.

# The flights between are scripted Mine and Dock orders, which fly themselves;
# hand-mining.inputs flies them by hand.
# Ore runs at Cinder Kiln until one hold more pays for the lens.
[[input]]
tick = 10
name = "core.mine"
source = "script"

