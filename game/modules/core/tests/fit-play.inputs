widget = "speaker.core.kiln_fitter"

[[note]]
tick = 548
text = "Orrin introduces himself; his bubble stays beside him, clear of the panel."

[[click]]
tick = 558
widget = "talk.core.kiln_fitter_intro"

[[click]]
