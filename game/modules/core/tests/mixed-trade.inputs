# Mixed cargo at Lantern Dock's exchange in a small window: Kiln ore sold and a plate
# bought, then a little ore cut and a whole ice floe, so 3 ore, 16 ice and 1 plate come
# aboard. Selling everything, the per-ware sells and the receipt after selling just the
# plate must all stay on screen (direction doc 8). 2 notes.
input = [
  { tick = 1, name = "core.ahead", payload = { down = true } },
  { tick = 11, name = "core.ahead", payload = { down = false } },
  { tick = 60, name = "core.mine" },
  { tick = 900, name = "core.dock", payload = { station = "core.kiln" } },
  { tick = 1800, name = "core.open" },
  { tick = 1810, name = "core.sell" },
  { tick = 1820, name = "core.buy", payload = { ware = "plate", units = 1 } },
  { tick = 1840, name = "core.launch" },
  { tick = 1850, name = "core.mine", payload = { rock = "core.rock1" } },
  { tick = 2765, name = "core.mine", payload = { rock = "core.ice1" } },
  { tick = 4365, name = "core.dock", payload = { station = "core.lantern" } },
  { tick = 5176, name = "core.open" },
  { tick = 5236, name = "core.sell", payload = { ware = "plate" } },
]

[[note]]
tick = 5226
text = "Lantern exchange with 3 ore, 16 ice and 1 plate aboard: Sell everything on screen."

[[note]]
tick = 5276
text = "After selling the plate: the receipt (Sold 1 plate. Paid +37 cr) on screen."
