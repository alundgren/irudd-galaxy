# Mining for `audio mix`: the mine order clicks, the beam hums and chips a unit a second
# until the hold is full and chimes; mining again is refused, then the ship flies on
# with a boost.
[[input]]
tick = 30
name = "core.mine"
payload = { down = true }
[[input]]
tick = 31
name = "core.mine"
payload = { down = false }
