tick = 405
action = "move"
widget = "key_cradle"

[[pointer]]
tick = 406
action = "move"
widget = "key_exchange"

[[pointer]]
tick = 407
action = "move"
widget = "key_office"

[[pointer]]
tick = 408
action = "move"
widget = "key_cradle"

[[pointer]]
tick = 409
action = "move"
widget = "key_exchange"

[[pointer]]
tick = 410
action = "move"
widget = "key_office"

[[pointer]]
