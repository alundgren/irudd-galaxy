# Hover sweep for the feel pass's UI sounds: dock at Cinder Kiln, then sweep the pointer
# across the station key and the building signs, first a widget every tick (faster than
# [ui] hover_gap, so hovers thin), then one every 10 ticks (each sounds), then open the
# exchange, click a resting button (deny) and go back.
[[input]]
tick = 1
name = "core.dock"
payload = { station = "core.kiln" }

[[pointer]]
tick = 400
action = "move"
widget = "key_exchange"

[[pointer]]
tick = 401
action = "move"
widget = "key_office"

[[pointer]]
tick = 402
action = "move"
widget = "key_cradle"

[[pointer]]
tick = 403
action = "move"
widget = "key_exchange"

