export type CountersApi = {
	-- An activity counter for the player, or a station or region.
	get: (self: CountersApi, kind: CounterKind, scope: CounterScopeArg?) -> number,
}
export type HistoryApi = {
	-- How many facts match.
	count: (self: HistoryApi, q: HistoryQuery) -> number,
	-- The sum of `amount` over matching facts.
	sum: (self: HistoryApi, q: HistoryQuery) -> number,
	-- Matching facts, oldest first. At most `q.limit`, and never more than 50.
	find: (self: HistoryApi, q: HistoryQuery) -> { Fact },
	-- The most recent matching fact.
	last: (self: HistoryApi, q: HistoryQuery) -> Fact?,
	-- One fact by ID.
	fact: (self: HistoryApi, id: FactId) -> Fact?,
