export type Trigger = { after: AfterSpec, run: (ctx: Ctx, fire: TriggerFire) -> () }
export type SurveyBuoy = { region: RegionId, position: Vec2, radius: number, planted_by: FactionId, read: boolean?, reward: { person: NpcId, choice: AnyId, credits: number, standing: { [FactionId]: number }, claimed: boolean? }? }
export type MapOverlay = { region: RegionId, center: Vec2, radius: number, owner: FactionId?, contested: boolean?, direction: Vec2? }
-- A requirement: world state, history and activity, never time. Build them with the
-- G.* helpers below; a list of requirements means all of them.
export type Requirement = string | { [any]: any }
-- A number, or `G.tunable(id)`: the current value of a pacing tunable.
export type Num = number | { tunable: TunableId }
-- Which facts a history requirement counts: all of history, since the beat started,
-- or since its current step started.
export type Since = "ever" | "start" | "step"
export type FactOpts = { at_least: Num?, since: Since? }
export type StepSpec = { id: string, goal: string, done: Requirement }
-- Credits are written as credits (like data files), not centicredits.
export type RewardSpec = { credits: number?, standing: { [FactionId]: number }?, flags: { FlagId }?, fit: { UpgradeId }? }
-- What a beat callback gets. Its writes made with `beat.why` apply atomically with the
-- transition; if the callback errors, the beat waits and tries again next tick.
export type BeatInfo = { id: BeatId, transition: "start" | "step" | "complete", step: number, step_id: string?, why: Cause }
export type BeatHook = (ctx: Ctx, beat: BeatInfo) -> ()
export type BeatSpec = { id: BeatId, act: number, kind: ("directed" | "situation")?, giver: NpcId?, goal: string, requires: Requirement?, steps: { StepSpec }?, done: Requirement?, rewards: RewardSpec?, on_start: BeatHook?, on_step: BeatHook?, on_complete: BeatHook? }
-- The HUD's goal line for one active beat.
export type GoalLine = { beat: BeatId, act: number, goal: string, giver: NpcId?, step: string? }
export type TeachSpec = { mechanic: FlagId, teacher: NpcId, slots: { SlotId }? }
export type DeliverSpec = { station: StationId, ware: WareId, quantity: number, ledger: LedgerId? }
-- The player for a beat: their name, ship and hold; `credits` are credits (40.5), not centicredits.
export type PilotView = { name: string, ship: ShipId?, hull: HullId?, docked_at: StationId?, region: RegionId?, position: Vec2?, cargo: { [WareId]: number }, consigned: { [LedgerId]: Consigned }, hold_free: number, credits: number }
-- An upgrade or tender on someone's list (`ctx.beats:service`); `cost` is in credits.
export type ServiceView = { id: string, name: string, effect: string, cost: number, seller: NpcId?, station: StationId?, owned: boolean }
-- Goods carried for someone else: whose they are, who they're for and where.
export type Consigned = { ware: WareId, quantity: number, owner: NpcId, to: NpcId, station: StationId }
-- Someone else's goods to carry, for `ctx.beats:consign` (the same fields, plus the ledger).
export type ConsignSpec = { ledger: LedgerId, ware: WareId, quantity: number, owner: NpcId, to: NpcId, station: StationId }
-- A point in a region, for `ctx.beats:distance`. Without `region`: the ship's region.
export type Spot = { x: number, y: number, region: RegionId? }
-- Read-only depletion views. `left` is remaining / full (1 when full is 0); a field's
-- `regrow` is units per region pulse.
export type FieldView = { id: FieldId, region: RegionId, rocks: number, remaining: number, full: number, left: number, regrow: number }
export type RockView = { id: RockId, field: FieldId, position: Vec2, remaining: number, initial: number, left: number }
-- A craft as scripts see it (`ctx.space:craft`). `owner` is a person or faction ID, or
-- "player" for the player's own craft.
export type CraftView = { id: ShipId, name: string, hull: HullId, owner: string, docked_at: StationId?, region: RegionId, position: Vec2, cargo: { [WareId]: number } }
-- A scripted craft to launch: owned by `npc`, berthed at `station`, with `cargo`.
export type CraftSpec = { id: ShipId, name: string, hull: HullId, npc: NpcId, station: StationId, cargo: { [WareId]: number }? }
-- A rock field to lay out: one rock per position, each with `amount` units.
export type FieldSpec = { id: FieldId, name: string, region: RegionId, rock_type: string, center: Vec2, radius: number, amount: number, regrow: number?, rocks: { Vec2 } }
-- Goal cargo for the player's ship. A consignment loads at a dock; `found = true` is
-- something found in space (a fragment in a spent rock) and loads wherever the ship is.
export type LoadSpec = { ware: WareId, quantity: number, found: boolean? }
export type DeedSpec = { faction: FactionId, deed: string, delta: number, tags: { string }? }
-- A market lever (galaxy-economy). Prices follow from the new supply; `set_base`
-- (centicredits) and `scale_base` move a line's base price itself.
export type Lever = { lever: "add_producers" | "add_consumers", station: StationId, ware: WareId, per_pulse: number }
	| { lever: "scale_producers" | "scale_consumers" | "scale_base", station: StationId, ware: WareId, factor: number }
	| { lever: "set_stock", station: StationId, ware: WareId, stock: number }
	| { lever: "set_base", station: StationId, ware: WareId, base_price: number }
	| { lever: "remove_line", station: StationId, ware: WareId }
	| { lever: "add_line", station: StationId, ware: WareId, line: { [string]: any } }

-- The ctx namespaces

export type CanonApi = {
	-- Read a canon node's current status.
	status: (self: CanonApi, id: string) -> string?,
	-- Open a manifest-declared node when its authored prerequisites hold. Reversible.
	open: (self: CanonApi, id: string, why: Cause) -> (),
}
export type KitApi = {
	-- Found a namespaced station from a JSON recipe validated against the shared art bible. Needs `npcs.write` and `market.lines` too. A later revision of the pack that founded it reopens its rolled-back scaffold in place.
	station: (self: KitApi, station: Station, recipe: string, dockmaster: Npc, market: { [WareId]: MarketLine }, why: Cause) -> (),
	-- Place or replace a survey buoy, unread and unclaimed. Space in reach reads its log and records survey_buoy_read. A reward is paid natively on a reply to its person: credits need `beats.write`, standing (a deed) needs `standing.write`.
	buoy: (self: KitApi, id: string, buoy: SurveyBuoy, why: Cause) -> (),
	-- Put or remove a namespaced map border or bearing.
	overlay: (self: KitApi, id: string, overlay: MapOverlay?, why: Cause) -> (),
}
export type RngApi = {
	-- A whole number in `lo..=hi` from the script's seeded stream.
	int: (self: RngApi, lo: number, hi: number) -> number,
