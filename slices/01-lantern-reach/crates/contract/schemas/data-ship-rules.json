{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShipRules",
  "description": "Tunables for ships, mining, lanes and control tiers. Saved with the world, so a\nsave keeps the rules it was played with until something changes them.",
  "type": "object",
  "properties": {
    "controls": {
      "$ref": "#/$defs/ControlRules",
      "default": {
        "automation": "cap.automation",
        "click_dock": "cap.click_dock",
        "click_fly": "cap.click_fly",
        "click_fly_range": 450.0,
        "click_mine": "cap.click_mine",
        "loop_limit": 8,
        "loops": "cap.loops",
        "map_travel": "cap.map_travel",
        "queue_limit": 6,
        "queues": "cap.queues",
        "saved_loop_limit": 3
      }
    },
    "docking": {
      "$ref": "#/$defs/DockingRules",
      "default": {
        "approach": 0.6000000238418579
      }
    },
    "flight": {
      "$ref": "#/$defs/FlightRules",
      "default": {
        "accel_time": 0.10000000149011612,
        "arrive_distance": 2.0,
        "brake": 1.5,
        "turn_rate": 270.0,
        "turn_slowdown": 0.5
      }
    },
    "lanes": {
      "$ref": "#/$defs/LaneRules",
      "default": {
        "mouth_radius": 70.0,
        "speed": 500.0
      }
    },
    "mining": {
      "$ref": "#/$defs/MiningRules",
      "default": {
        "radius_base": 6.0,
        "radius_per_sqrt_unit": 3.0,
        "reach": 40.0
      }
    },
    "regrowth": {
      "$ref": "#/$defs/RegrowthRules",
      "default": {
        "pulses": [
          {
            "counter": "dockings",
            "weight": 1
          },
          {
            "counter": "jumps",
            "weight": 1
          }
        ],
        "reform_share": 0.25
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ControlRules": {
      "description": "Control tiers as progression. Each input mode is unlocked by a per-save flag\n(`Player::flags`); the flag names are data.",
      "type": "object",
      "properties": {
        "automation": {
          "description": "The player's automated craft may run saved loops.",
          "$ref": "#/$defs/FlagId",
          "default": "cap.automation"
        },
        "click_dock": {
          "description": "Click a station: fly into the ring and dock.",
          "$ref": "#/$defs/FlagId",
          "default": "cap.click_dock"
        },
        "click_fly": {
          "description": "Click a point near the ship: fly there and stop.",
          "$ref": "#/$defs/FlagId",
          "default": "cap.click_fly"
        },
        "click_fly_range": {
          "description": "How far from the ship a click-to-fly point may be (map travel has no limit).",
          "type": "number",
          "format": "float",
          "default": 450.0
        },
        "click_mine": {
          "description": "Click a rock: fly into reach and mine.",
          "$ref": "#/$defs/FlagId",
          "default": "cap.click_mine"
        },
        "loop_limit": {
          "description": "Most orders in a saved loop.",
          "type": "integer",
          "format": "uint32",
          "default": 8,
          "minimum": 0
        },
        "loops": {
          "description": "Save a queue as a named loop and run it.",
          "$ref": "#/$defs/FlagId",
          "default": "cap.loops"
        },
        "map_travel": {
          "description": "Click anything on the map, any distance, routing through lanes.",
          "$ref": "#/$defs/FlagId",
          "default": "cap.map_travel"
        },
        "queue_limit": {
          "description": "Most orders in a queue.",
          "type": "integer",
          "format": "uint32",
          "default": 6,
          "minimum": 0
        },
        "queues": {
          "description": "Shift-click appends orders to a queue.",
          "$ref": "#/$defs/FlagId",
          "default": "cap.queues"
        },
        "saved_loop_limit": {
          "description": "Most saved loops.",
          "type": "integer",
          "format": "uint32",
          "default": 3,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "CounterKind": {
      "description": "Activity counters. Pacing reads these, never a clock.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "dockings",
            "jumps",
            "sessions",
            "units_mined",
            "rocks_depleted",
            "sales",
            "purchases",
            "scouts",
            "orders_done"
          ]
        },
        {
          "description": "Sales and deliveries, one per transaction.",
          "type": "string",
          "const": "deliveries"
        }
      ]
    },
    "DockingRules": {
      "type": "object",
      "properties": {
        "approach": {
          "description": "A dock order steers until the ship is this far into the ring (share of its\nradius from the centre), then docks.",
          "type": "number",
          "format": "float",
          "default": 0.6000000238418579
        }
      },
      "additionalProperties": false
    },
    "FlagId": {
      "description": "Stable flag id, e.g. `flag.nav_chip`.",
      "type": "string",
      "examples": [
        "flag.nav_chip"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "FlightRules": {
      "description": "Arcade flight feel. Ships stop when nothing pushes them: there is no coasting.",
      "type": "object",
      "properties": {
        "accel_time": {
          "description": "Seconds from rest to top speed, for hulls without their own `accel`.",
          "type": "number",
          "format": "float",
          "default": 0.10000000149011612
        },
        "arrive_distance": {
          "description": "A fly order is done within this many world units of its point.",
          "type": "number",
          "format": "float",
          "default": 2.0
        },
        "brake": {
          "description": "Braking is this many times stronger than accelerating, so release stops fast.",
          "type": "number",
          "format": "float",
          "default": 1.5
        },
        "turn_rate": {
          "description": "Degrees per second, for hulls without their own `turn_rate`.",
          "type": "number",
          "format": "float",
          "default": 270.0
        },
        "turn_slowdown": {
          "description": "Share of top speed lost while moving directly away from the heading (0..=1).\nThe ship swings round to face where it goes, and turn rate shapes the feel.",
          "type": "number",
          "format": "float",
          "default": 0.5
        }
      },
      "additionalProperties": false
    },
    "LaneRules": {
      "description": "Lanes are currents: every hull rides them at the same speed and can't steer.",
      "type": "object",
      "properties": {
        "mouth_radius": {
          "description": "A ship within this distance of a lane mouth can enter the lane.",
          "type": "number",
          "format": "float",
          "default": 70.0
        },
        "speed": {
          "description": "World units per second inside a lane.",
          "type": "number",
          "format": "float",
          "default": 500.0
        }
      },
      "additionalProperties": false
    },
    "MiningRules": {
      "type": "object",
      "properties": {
        "radius_base": {
          "description": "A rock's radius is `radius_base + radius_per_sqrt_unit * sqrt(remaining)`.",
          "type": "number",
          "format": "float",
          "default": 6.0
        },
        "radius_per_sqrt_unit": {
          "type": "number",
          "format": "float",
          "default": 3.0
        },
        "reach": {
          "description": "A ship mines while within this distance of a rock's edge.",
          "type": "number",
          "format": "float",
          "default": 40.0
        }
      },
      "additionalProperties": false
    },
    "PulseWeight": {
      "type": "object",
      "properties": {
        "counter": {
          "$ref": "#/$defs/CounterKind"
        },
        "weight": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "counter",
        "weight"
      ]
    },
    "RegrowthRules": {
      "description": "How rocks regrow. Driven by activity counters in the field's region, never by time.",
      "type": "object",
      "properties": {
        "pulses": {
          "description": "Region counters that make up a region's activity (\"region pulses\"), with weights.",
          "type": "array",
          "default": [
            {
              "counter": "dockings",
              "weight": 1
            },
            {
              "counter": "jumps",
              "weight": 1
            }
          ],
          "items": {
            "$ref": "#/$defs/PulseWeight"
          }
        },
        "reform_share": {
          "description": "A spent rock reforms (can be mined again) once regrowth has brought it back to\nthis share of its full yield. Reforming adds no units of its own.",
          "type": "number",
          "format": "float",
          "default": 0.25
        }
      },
      "additionalProperties": false
    }
  }
}
