{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HappeningsFile",
  "description": "`packs/core/data/happenings.toml`: the authored happenings.",
  "type": "object",
  "properties": {
    "happening": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Happening"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "AnyId": {
      "description": "Stable entity id, e.g. `quest.ice_for_kettle`.",
      "type": "string",
      "examples": [
        "quest.ice_for_kettle"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "CauseFact": {
      "description": "One fact a happening waits for: a fact by ID (it must exist when the happening is\nwritten), or a pattern a fact has to match. A pattern names the fact's `kind`\n(`stage_built` matches `core.stage_built` and `gm.kettle_growth.stage_built`, as\nline citations do) and any subjects or amount it must have.",
      "type": "object",
      "properties": {
        "amount": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "faction": {
          "anyOf": [
            {
              "$ref": "#/$defs/FactionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/FactId"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "npc": {
          "anyOf": [
            {
              "$ref": "#/$defs/NpcId"
            },
            {
              "type": "null"
            }
          ]
        },
        "other": {
          "type": [
            "string",
            "null"
          ]
        },
        "station": {
          "anyOf": [
            {
              "$ref": "#/$defs/StationId"
            },
            {
              "type": "null"
            }
          ]
        },
        "ware": {
          "anyOf": [
            {
              "$ref": "#/$defs/WareId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "FactId": {
      "type": "string",
      "examples": [
        "fact.42"
      ],
      "pattern": "^fact\\.[0-9]+$"
    },
    "FactionId": {
      "description": "Stable faction id, e.g. `faction.wharf_cooperative`.",
      "type": "string",
      "examples": [
        "faction.wharf_cooperative"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "Happening": {
      "description": "One happening.",
      "type": "object",
      "properties": {
        "by": {
          "description": "The pack that wrote it, if a pack did. `None`: the core pack's data.",
          "anyOf": [
            {
              "$ref": "#/$defs/PackId"
            },
            {
              "type": "null"
            }
          ]
        },
        "cause": {
          "$ref": "#/$defs/HappeningCause"
        },
        "id": {
          "$ref": "#/$defs/HappeningId"
        },
        "lasts": {
          "$ref": "#/$defs/Lasts"
        },
        "line": {
          "description": "What its speaker says when it starts.",
          "$ref": "#/$defs/HappeningLine"
        },
        "run": {
          "description": "Where it is in its run. Written by the runtime only; data and packs leave it\nupcoming.",
          "$ref": "#/$defs/HappeningRun"
        },
        "show": {
          "description": "What the docked view shows while it runs, as `<kind>:<value>` entries\n([`SHOW_KINDS`]): `\"banner_string:lamps\"`, `\"crowd:pier.north\"`,\n`\"residents:+6\"`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "station": {
          "$ref": "#/$defs/StationId"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "station",
        "lasts",
        "cause",
        "line"
      ]
    },
    "HappeningCause": {
      "description": "The facts a happening waits for. It starts once each one exists.",
      "type": "object",
      "properties": {
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CauseFact"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "facts"
      ]
    },
    "HappeningId": {
      "description": "Stable happening id, e.g. `happening.wharf.lamp_night`.",
      "type": "string",
      "examples": [
        "happening.wharf.lamp_night"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "HappeningLine": {
      "description": "The line a happening's speaker says when it starts, in the first person.",
      "type": "object",
      "properties": {
        "choices": {
          "description": "Answers the player may give (at most four). A pack's `on.reply` handler acts on\nthe pick, the way any dock-talk offer works (the core pack's harvest gift).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TalkChoice"
          }
        },
        "id": {
          "description": "`line.<speaker>.<name>`, stable, so a line said twice can be told apart.",
          "type": "string"
        },
        "speaker": {
          "description": "A person at the station.",
          "$ref": "#/$defs/NpcId"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "speaker",
        "text"
      ]
    },
    "HappeningRun": {
      "description": "Where a happening is in its run.",
      "oneOf": [
        {
          "description": "Waiting for its cause facts, or for the station to be free.",
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "upcoming"
            }
          },
          "additionalProperties": false,
          "required": [
            "status"
          ]
        },
        {
          "description": "Running. `first_docking` is the station's counted dockings when it started\n(the docking it started in counts as its first); it ends when the count\nreaches `first_docking + lasts.dockings`. `cites` are the cause facts that\nstarted it.",
          "type": "object",
          "properties": {
            "cites": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/FactId"
              }
            },
            "first_docking": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "since": {
              "$ref": "#/$defs/Tick"
            },
            "status": {
              "type": "string",
              "const": "active"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "since",
            "first_docking",
            "cites"
          ]
        },
        {
          "description": "Over.",
          "type": "object",
          "properties": {
            "at": {
              "$ref": "#/$defs/Tick"
            },
            "first_docking": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "since": {
              "$ref": "#/$defs/Tick"
            },
            "status": {
              "type": "string",
              "const": "ended"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "since",
            "first_docking",
            "at"
          ]
        }
      ]
    },
    "Lasts": {
      "description": "How long a happening runs: counted player dockings at its station.",
      "type": "object",
      "properties": {
        "dockings": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "dockings"
      ]
    },
    "NpcId": {
      "description": "Stable npc id, e.g. `npc.ilse`.",
      "type": "string",
      "examples": [
        "npc.ilse"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "PackId": {
      "description": "Stable pack id, e.g. `core`.",
      "type": "string",
      "examples": [
        "core"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
    },
    "StationId": {
      "description": "Stable station id, e.g. `station.kettle_dock`.",
      "type": "string",
      "examples": [
        "station.kettle_dock"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "TalkChoice": {
      "description": "One answer a line offers.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable ID, e.g. `choice.side_coop`.",
          "$ref": "#/$defs/AnyId"
        },
        "text": {
          "description": "What the player says, in a few words.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ]
    },
    "Tick": {
      "description": "Simulation tick count (30 per second nominal; the sim never reads a clock).",
      "type": "integer",
      "minimum": 0
    },
    "WareId": {
      "description": "Stable ware id, e.g. `ware.ice`.",
      "type": "string",
      "examples": [
        "ware.ice"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    }
  }
}
