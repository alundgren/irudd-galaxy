    "RockId": {
      "description": "Stable rock id, e.g. `rock.shallows.ice.03`.",
      "type": "string",
      "examples": [
        "rock.shallows.ice.03"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "ShipId": {
      "description": "Stable ship id, e.g. `ship.player`.",
      "type": "string",
      "examples": [
        "ship.player"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "Since": {
      "description": "Which facts a history requirement counts.",
      "oneOf": [
        {
          "description": "The whole history.",
          "type": "string",
          "const": "ever"
        },
        {
          "description": "Since the beat started (for beat requirements).",
          "type": "string",
          "const": "start"
        },
        {
          "description": "Since the current step started.",
          "type": "string",
          "const": "step"
        }
      ]
    },
    "SocketId": {
      "description": "Stable socket id, e.g. `socket.drill`.",
      "type": "string",
      "examples": [
        "socket.drill"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "StationId": {
      "description": "Stable station id, e.g. `station.kettle_dock`.",
      "type": "string",
      "examples": [
        "station.kettle_dock"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "Tick": {
      "description": "Simulation tick count (30 per second nominal; the sim never reads a clock).",
      "type": "integer",
      "minimum": 0
    },
    "TraitId": {
      "description": "Stable trait id, e.g. `trait.rich_face`.",
      "type": "string",
      "examples": [
        "trait.rich_face"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "TunableId": {
      "description": "Stable tunable id, e.g. `nav_chip.dockings`.",
      "type": "string",
      "examples": [
        "nav_chip.dockings"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "TunableValue": {
      "anyOf": [
        {
          "type": "number",
          "format": "double"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "UpgradeData": {
      "description": "An upgrade as authored; `cost` in credits.",
      "type": "object",
      "properties": {
        "cost": {
          "description": "In credits; 0 for a gift.",
          "type": "number",
          "format": "double"
        },
        "effect": {
          "type": "string"
        },
        "grants": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/FlagId"
          }
        },
        "id": {
          "$ref": "#/$defs/UpgradeId"
        },
        "look": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "mass": {
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "modifiers": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Modifier"
          }
        },
        "name": {
          "type": "string"
        },
        "power": {
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "seller": {
          "anyOf": [
            {
              "$ref": "#/$defs/NpcId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "socket": {
          "description": "The socket it fits (`socket.rack` for control modules). See `ship_parts.toml`.",
          "anyOf": [
            {
              "$ref": "#/$defs/SocketId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "$ref": "#/$defs/PartSource",
