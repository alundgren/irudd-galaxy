{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UpgradesFile",
  "description": "`upgrades.toml`: what hullwrights and dockmasters fit and build (W4).",
  "type": "object",
  "properties": {
    "craft": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/CraftData"
      }
    },
    "upgrade": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/UpgradeData"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "AnyId": {
      "description": "Stable entity id, e.g. `quest.ice_for_kettle`.",
      "type": "string",
      "examples": [
        "quest.ice_for_kettle"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "BeatId": {
      "description": "Stable beat id, e.g. `beat.first_delivery`.",
      "type": "string",
      "examples": [
        "beat.first_delivery"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "CauseId": {
      "type": "string",
      "examples": [
        "cause.42"
      ],
      "pattern": "^cause\\.[0-9]+$"
    },
    "CounterKind": {
      "description": "Activity counters. Pacing reads these, never a clock.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "dockings",
            "jumps",
            "sessions",
            "units_mined",
            "rocks_depleted",
            "sales",
            "purchases",
            "scouts",
            "orders_done"
          ]
        },
        {
          "description": "Sales and deliveries, one per transaction.",
          "type": "string",
          "const": "deliveries"
        },
        {
          "description": "Handovers to a ledger (goal deliveries, station growth, dispute tallies).",
          "type": "string",
          "const": "ledger_deliveries"
        }
      ]
    },
    "CraftData": {
      "description": "A craft (tender) as authored; `cost` in credits.",
      "type": "object",
      "properties": {
        "cost": {
          "description": "In credits.",
          "type": "number",
          "format": "double"
        },
        "effect": {
          "type": "string"
        },
        "grants": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/FlagId"
          }
        },
        "hull": {
          "$ref": "#/$defs/HullId"
        },
        "id": {
          "$ref": "#/$defs/ShipId"
        },
        "name": {
          "type": "string"
        },
        "seller": {
          "anyOf": [
            {
              "$ref": "#/$defs/NpcId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "station": {
          "$ref": "#/$defs/StationId"
        },
        "unlock": {
          "$ref": "#/$defs/Requirement",
          "default": "always"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "effect",
        "hull",
        "cost",
        "station"
      ]
    },
    "FactId": {
      "type": "string",
      "examples": [
        "fact.42"
      ],
      "pattern": "^fact\\.[0-9]+$"
    },
    "FactKind": {
      "description": "Stable fact kind id, e.g. `dock`.",
      "type": "string",
      "examples": [
        "dock"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
    },
    "FactionId": {
      "description": "Stable faction id, e.g. `faction.wharf_cooperative`.",
      "type": "string",
      "examples": [
        "faction.wharf_cooperative"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "FlagId": {
      "description": "Stable flag id, e.g. `flag.nav_chip`.",
      "type": "string",
      "examples": [
        "flag.nav_chip"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "HistoryQuery": {
      "description": "A history filter. Empty matches everything. `count`, `find` and `last` take one.",
      "type": "object",
      "properties": {
        "after": {
          "description": "Facts with an ID greater than this (for paging).",
          "anyOf": [
            {
              "$ref": "#/$defs/FactId"
            },
            {
              "type": "null"
            }
          ]
        },
        "cause": {
          "anyOf": [
            {
              "$ref": "#/$defs/CauseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "faction": {
          "anyOf": [
            {
              "$ref": "#/$defs/FactionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/FactKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "description": "Most results `find` returns (oldest first).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "npc": {
          "anyOf": [
            {
              "$ref": "#/$defs/NpcId"
            },
            {
              "type": "null"
            }
          ]
        },
        "other": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnyId"
            },
            {
              "type": "null"
            }
          ]
        },
        "region": {
          "anyOf": [
            {
              "$ref": "#/$defs/RegionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "rock": {
          "anyOf": [
            {
              "$ref": "#/$defs/RockId"
            },
            {
              "type": "null"
            }
          ]
        },
        "ship": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShipId"
            },
            {
              "type": "null"
            }
          ]
        },
        "since": {
          "description": "Facts at or after this tick.",
          "anyOf": [
            {
              "$ref": "#/$defs/Tick"
            },
            {
              "type": "null"
            }
          ]
        },
        "station": {
          "anyOf": [
            {
              "$ref": "#/$defs/StationId"
            },
            {
              "type": "null"
            }
          ]
        },
        "until": {
          "description": "Facts at or before this tick.",
          "anyOf": [
            {
              "$ref": "#/$defs/Tick"
            },
            {
              "type": "null"
            }
          ]
        },
        "ware": {
          "anyOf": [
            {
              "$ref": "#/$defs/WareId"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "HullId": {
      "description": "Stable hull id, e.g. `hull.wren`.",
      "type": "string",
      "examples": [
        "hull.wren"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "Material": {
      "description": "Units of a ware a Make consumes from the hold.",
      "type": "object",
      "properties": {
        "units": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "ware": {
          "$ref": "#/$defs/WareId"
        }
      },
      "additionalProperties": false,
      "required": [
        "ware",
        "units"
      ]
    },
    "Modifier": {
      "description": "The fixed list of native effects traits, fittings and ranks may have. Each is\nsmall and qualitative; `galaxy-progress` adds them up per ship and the ship,\neconomy and app crates read the totals.",
      "oneOf": [
        {
          "description": "Multiplies mining rate (the mining lens: 1.5).",
          "type": "object",
          "properties": {
            "factor": {
              "type": "number",
              "format": "double"
            },
            "modifier": {
              "type": "string",
              "const": "mining_rate"
            }
          },
          "required": [
            "modifier",
            "factor"
          ]
        },
        {
          "description": "Mining while facing a rock's richest face yields this much more (Rimesight).",
          "type": "object",
          "properties": {
            "bonus": {
              "type": "number",
              "format": "double"
            },
            "modifier": {
              "type": "string",
              "const": "rich_face"
            }
          },
          "required": [
            "modifier",
            "bonus"
          ]
        },
        {
          "description": "Extra hold units (hold extender, Wren rank 2).",
          "type": "object",
          "properties": {
            "modifier": {
              "type": "string",
              "const": "hold"
            },
            "units": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "modifier",
            "units"
          ]
        },
        {
          "description": "Extra hold units on each of the player's tenders (Tandem rank 3).",
          "type": "object",
          "properties": {
            "modifier": {
              "type": "string",
              "const": "tender_hold"
            },
            "units": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "modifier",
            "units"
          ]
        },
        {
          "description": "Multiplies turn rate.",
          "type": "object",
          "properties": {
            "factor": {
              "type": "number",
              "format": "double"
            },
            "modifier": {
              "type": "string",
              "const": "turn_rate"
            }
          },
          "required": [
            "modifier",
            "factor"
          ]
        },
        {
          "description": "Multiplies top speed.",
          "type": "object",
          "properties": {
            "factor": {
              "type": "number",
              "format": "double"
            },
            "modifier": {
              "type": "string",
              "const": "speed"
            }
          },
          "required": [
            "modifier",
            "factor"
          ]
        },
        {
          "description": "Multiplies the camera's zoom (below 1 shows more around the ship).",
          "type": "object",
          "properties": {
            "factor": {
              "type": "number",
              "format": "double"
            },
            "modifier": {
              "type": "string",
              "const": "zoom"
            }
          },
          "required": [
            "modifier",
            "factor"
          ]
        },
        {
          "description": "Multiplies docking ring reach (Ringwise: 1.25).",
          "type": "object",
          "properties": {
            "factor": {
              "type": "number",
              "format": "double"
            },
            "modifier": {
              "type": "string",
              "const": "dock_reach"
            }
          },
          "required": [
            "modifier",
            "factor"
          ]
        },
        {
          "description": "Lane mouths catch the ship from this radius (Lanerunner: 105).",
          "type": "object",
          "properties": {
            "modifier": {
              "type": "string",
              "const": "mouth_radius"
            },
            "radius": {
              "type": "number",
              "format": "float"
            }
          },
          "required": [
            "modifier",
            "radius"
          ]
        },
        {
          "description": "Live prices of stations within this distance (price glass: 1200).",
          "type": "object",
          "properties": {
            "modifier": {
              "type": "string",
              "const": "price_glass"
            },
            "range": {
              "type": "number",
              "format": "float"
            }
          },
          "required": [
            "modifier",
            "range"
          ]
        },
        {
          "description": "Mines from this many world units further off (the long-throw drill).",
          "type": "object",
          "properties": {
            "modifier": {
              "type": "string",
              "const": "mining_reach"
            },
            "units": {
              "type": "number",
              "format": "float"
            }
          },
          "required": [
            "modifier",
            "units"
          ]
        },
        {
          "description": "Shows what's left in rocks within this distance (the seam lamp).",
          "type": "object",
          "properties": {
            "modifier": {
              "type": "string",
              "const": "seam_lamp"
            },
            "range": {
              "type": "number",
              "format": "float"
            }
          },
          "required": [
            "modifier",
            "range"
          ]
        },
        {
          "description": "Multiplies standing gains from deeds with this tag (Good neighbour: delivery x1.5).",
          "type": "object",
          "properties": {
            "factor": {
              "type": "number",
              "format": "double"
            },
            "modifier": {
              "type": "string",
              "const": "deed_bonus"
            },
            "tag": {
              "type": "string"
            }
          },
          "required": [
            "modifier",
            "tag",
            "factor"
          ]
        },
        {
          "description": "A named presentation feature for the app and talk (`sell_preview`,\n`last_visit_greeting`, `lane_radio`, `rumor_first`, `seam_sense` ...).",
          "type": "object",
          "properties": {
            "feature": {
              "type": "string"
            },
            "modifier": {
              "type": "string",
              "const": "feature"
            }
          },
          "required": [
            "modifier",
            "feature"
          ]
        }
      ]
    },
    "NpcId": {
      "description": "Stable npc id, e.g. `npc.ilse`.",
      "type": "string",
      "examples": [
        "npc.ilse"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "Num": {
      "description": "A number, or the current value of a tunable.",
      "anyOf": [
        {
          "type": "number",
          "format": "double"
        },
        {
          "type": "object",
          "properties": {
            "tunable": {
              "$ref": "#/$defs/TunableId"
            }
          },
          "required": [
            "tunable"
          ]
        }
      ]
    },
    "PartSource": {
      "description": "Where a part comes from: one tab of the wharf at the part's `station`.",
      "oneOf": [
        {
          "description": "Bought for its `cost` and fitted.",
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "const": "ready"
            }
          },
          "additionalProperties": false,
          "required": [
            "from"
          ]
        },
        {
          "description": "Made from materials in the hold, once its blueprint is found. No credits.",
          "type": "object",
          "properties": {
            "blueprint": {
              "$ref": "#/$defs/FlagId"
            },
            "from": {
              "type": "string",
              "const": "make"
            },
            "materials": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Material"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "from",
            "blueprint",
            "materials"
          ]
        },
        {
          "description": "Ordered for its `cost` from the wharf keeper's friend, who sends it after the\nplayer's next docking at the friend's station; it arrives in the locker.",
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "const": "friend"
            },
            "npc": {
              "$ref": "#/$defs/NpcId"
            },
            "station": {
              "$ref": "#/$defs/StationId"
            }
          },
          "additionalProperties": false,
          "required": [
            "from",
            "npc",
            "station"
          ]
        }
      ]
    },
    "RegionId": {
      "description": "Stable region id, e.g. `region.lantern_shallows`.",
      "type": "string",
      "examples": [
        "region.lantern_shallows"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "Requirement": {
      "description": "A condition over world state, history and activity counters. Never time: there is\nno clock to name. Used by beats, upgrade unlocks and prestige.",
      "oneOf": [
        {
          "description": "Always holds.",
          "type": "string",
          "const": "always"
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Requirement"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "all"
          ]
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Requirement"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "any"
          ]
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/Requirement"
            }
          },
          "additionalProperties": false,
          "required": [
            "not"
          ]
        },
        {
          "type": "object",
          "properties": {
            "beat_done": {
              "$ref": "#/$defs/BeatId"
            }
          },
          "additionalProperties": false,
          "required": [
            "beat_done"
          ]
        },
        {
          "type": "object",
          "properties": {
            "beat_started": {
              "$ref": "#/$defs/BeatId"
            }
          },
          "additionalProperties": false,
          "required": [
            "beat_started"
          ]
        },
        {
          "description": "Started and not completed.",
          "type": "object",
          "properties": {
            "beat_active": {
              "$ref": "#/$defs/BeatId"
            }
          },
          "additionalProperties": false,
          "required": [
            "beat_active"
          ]
        },
        {
          "description": "The beat has reached at least this step (0 = its first step is under way).",
          "type": "object",
          "properties": {
            "beat_step": {
              "type": "object",
              "properties": {
                "at_least": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                },
                "beat": {
                  "$ref": "#/$defs/BeatId"
                }
              },
              "required": [
                "beat",
                "at_least"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "beat_step"
          ]
        },
        {
          "description": "An activity counter for the player, a station or a region.",
          "type": "object",
          "properties": {
            "counter": {
              "type": "object",
              "properties": {
                "at_least": {
                  "$ref": "#/$defs/Num"
                },
                "kind": {
                  "$ref": "#/$defs/CounterKind"
                },
                "region": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/RegionId"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "station": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/StationId"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "kind",
                "at_least"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "counter"
          ]
        },
        {
          "description": "At least `at_least` history facts match (default 1).",
          "type": "object",
          "properties": {
            "facts": {
              "type": "object",
              "properties": {
                "at_least": {
                  "$ref": "#/$defs/Num",
                  "default": 1.0
                },
                "query": {
                  "$ref": "#/$defs/HistoryQuery"
                },
                "since": {
                  "$ref": "#/$defs/Since",
                  "default": "ever"
                }
              },
              "required": [
                "query"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "facts"
          ]
        },
        {
          "description": "The `amount`s of matching facts add up to at least `at_least`.",
          "type": "object",
          "properties": {
            "sum": {
              "type": "object",
              "properties": {
                "at_least": {
                  "$ref": "#/$defs/Num"
                },
                "query": {
                  "$ref": "#/$defs/HistoryQuery"
                },
                "since": {
                  "$ref": "#/$defs/Since",
                  "default": "ever"
                }
              },
              "required": [
                "query",
                "at_least"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "sum"
          ]
        },
        {
          "type": "object",
          "properties": {
            "flag": {
              "$ref": "#/$defs/FlagId"
            }
          },
          "additionalProperties": false,
          "required": [
            "flag"
          ]
        },
        {
          "type": "object",
          "properties": {
            "trait": {
              "$ref": "#/$defs/TraitId"
            }
          },
          "additionalProperties": false,
          "required": [
            "trait"
          ]
        },
        {
          "type": "object",
          "properties": {
            "fitted": {
              "$ref": "#/$defs/UpgradeId"
            }
          },
          "additionalProperties": false,
          "required": [
            "fitted"
          ]
        },
        {
          "description": "The player's ship is this hull.",
          "type": "object",
          "properties": {
            "hull": {
              "$ref": "#/$defs/HullId"
            }
          },
          "additionalProperties": false,
          "required": [
            "hull"
          ]
        },
        {
          "description": "The player owns this craft.",
          "type": "object",
          "properties": {
            "owns": {
              "$ref": "#/$defs/ShipId"
            }
          },
          "additionalProperties": false,
          "required": [
            "owns"
          ]
        },
        {
          "description": "Credits, in centicredits.",
          "type": "object",
          "properties": {
            "credits": {
              "type": "object",
              "properties": {
                "at_least": {
                  "$ref": "#/$defs/Num"
                }
              },
              "required": [
                "at_least"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "credits"
          ]
        },
        {
          "description": "Units of a ware in the player ship's hold.",
          "type": "object",
          "properties": {
            "cargo": {
              "type": "object",
              "properties": {
                "at_least": {
                  "$ref": "#/$defs/Num"
                },
                "ware": {
                  "$ref": "#/$defs/WareId"
                }
              },
              "required": [
                "ware",
                "at_least"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "cargo"
          ]
        },
        {
          "description": "Free room in the player ship's hold.",
          "type": "object",
          "properties": {
            "hold_free": {
              "type": "object",
              "properties": {
                "at_least": {
                  "$ref": "#/$defs/Num"
                }
              },
              "required": [
                "at_least"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "hold_free"
          ]
        },
        {
          "description": "The player ship is docked at this station.",
          "type": "object",
          "properties": {
            "docked_at": {
              "$ref": "#/$defs/StationId"
            }
          },
          "additionalProperties": false,
          "required": [
            "docked_at"
          ]
        },
        {
          "description": "The player ship is docked anywhere.",
          "type": "string",
          "const": "docked"
        },
        {
          "description": "The player ship is in this region.",
          "type": "object",
          "properties": {
