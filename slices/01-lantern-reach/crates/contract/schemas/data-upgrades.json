          }
        },
        "station": {
          "anyOf": [
            {
              "$ref": "#/$defs/StationId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unlock": {
          "$ref": "#/$defs/Requirement",
          "default": "always"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "effect",
        "cost"
      ]
    },
    "UpgradeId": {
      "description": "Stable upgrade id, e.g. `upgrade.mining_lens`.",
      "type": "string",
      "examples": [
        "upgrade.mining_lens"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "WareId": {
      "description": "Stable ware id, e.g. `ware.ice`.",
      "type": "string",
      "examples": [
        "ware.ice"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    }
