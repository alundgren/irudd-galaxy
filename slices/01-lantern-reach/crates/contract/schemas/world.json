{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorldState",
  "description": "The whole simulated world.",
  "type": "object",
  "properties": {
    "counters": {
      "description": "Activity counters that pace beats and unlocks (never clock time).",
      "$ref": "#/$defs/ActivityCounters"
    },
    "factions": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$": {
          "$ref": "#/$defs/Faction"
        }
      }
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$": {
          "$ref": "#/$defs/RockField"
        }
      }
    },
    "hulls": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$": {
          "$ref": "#/$defs/Hull"
        }
      }
    },
    "lanes": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$": {
          "$ref": "#/$defs/Lane"
        }
      }
    },
    "markets": {
      "description": "One market per station that trades, keyed by station.",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$": {
          "$ref": "#/$defs/Market"
        }
      }
    },
    "meta": {
      "$ref": "#/$defs/WorldMeta"
    },
    "npcs": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$": {
          "$ref": "#/$defs/Npc"
        }
      }
    },
    "player": {
      "$ref": "#/$defs/Player"
    },
    "regions": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$": {
          "$ref": "#/$defs/Region"
        }
      }
    },
    "rock_types": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$": {
          "$ref": "#/$defs/RockType"
        }
      }
    },
    "rocks": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$": {
          "$ref": "#/$defs/Rock"
        }
      }
    },
    "rumors": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$": {
          "$ref": "#/$defs/Rumor"
        }
      }
    },
    "ships": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$": {
          "$ref": "#/$defs/Ship"
        }
      }
    },
    "stations": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$": {
          "$ref": "#/$defs/Station"
        }
      }
    },
    "wares": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$": {
          "$ref": "#/$defs/Ware"
        }
      }
    }
  },
  "required": [
    "meta",
    "player",
    "regions",
    "lanes",
    "stations",
    "markets",
    "wares",
    "hulls",
    "rock_types",
    "fields",
    "rocks",
    "ships",
    "factions",
    "npcs",
    "rumors",
    "counters"
  ],
  "$defs": {
    "ActivityCounters": {
      "description": "Read-only activity counters per player, station and region.",
      "type": "object",
      "properties": {
        "player": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "regions": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0
              }
            }
          }
        },
        "stations": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0
              }
            }
          }
        }
      },
      "required": [
        "player",
        "stations",
        "regions"
      ]
    },
    "BuildState": {
      "description": "A station's visible growth: a stage number plus the kit parts attached.",
      "type": "object",
      "properties": {
        "parts": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/PartId"
          },
          "uniqueItems": true
        },
        "stage": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "stage"
      ]
    },
    "Condition": {
      "description": "A world condition. Evaluated by the engine against world state only.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "hold_full"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "hold_empty"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "price_at_least"
            },
            "price": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "station": {
              "$ref": "#/$defs/StationId"
            },
            "ware": {
              "$ref": "#/$defs/WareId"
            }
          },
          "required": [
            "kind",
            "station",
            "ware",
            "price"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "price_at_most"
            },
            "price": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "station": {
              "$ref": "#/$defs/StationId"
            },
            "ware": {
              "$ref": "#/$defs/WareId"
            }
          },
          "required": [
            "kind",
            "station",
            "ware",
            "price"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "stock_at_least"
            },
            "station": {
              "$ref": "#/$defs/StationId"
            },
            "stock": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "ware": {
              "$ref": "#/$defs/WareId"
            }
          },
          "required": [
            "kind",
            "station",
            "ware",
            "stock"
          ]
        },
        {
          "type": "object",
          "properties": {
            "counter": {
              "$ref": "#/$defs/CounterKind"
            },
            "kind": {
              "type": "string",
              "const": "counter_at_least"
            },
            "scope": {
              "$ref": "#/$defs/CounterScope"
            },
            "value": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "counter",
            "scope",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "flag": {
              "$ref": "#/$defs/FlagId"
            },
            "kind": {
              "type": "string",
              "const": "flag_set"
            }
          },
          "required": [
            "kind",
            "flag"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "all"
            },
            "of": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Condition"
              }
            }
          },
          "required": [
            "kind",
            "of"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "any"
            },
            "of": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Condition"
              }
            }
          },
          "required": [
            "kind",
            "of"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cond": {
              "$ref": "#/$defs/Condition"
            },
            "kind": {
              "type": "string",
              "const": "not"
            }
          },
          "required": [
            "kind",
            "cond"
          ]
        }
      ]
    },
    "CounterKind": {
      "description": "Activity counters. Pacing reads these, never a clock.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "dockings",
            "jumps",
            "sessions",
            "units_mined",
            "rocks_depleted",
            "sales",
            "purchases",
            "scouts",
            "orders_done"
          ]
        },
        {
          "description": "Sales and deliveries, one per transaction.",
          "type": "string",
          "const": "deliveries"
        }
      ]
    },
    "CounterScope": {
      "description": "Where a counter is read.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "player"
            }
          },
          "required": [
            "scope"
          ]
        },
        {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "station"
            },
            "station": {
              "$ref": "#/$defs/StationId"
            }
          },
          "required": [
            "scope",
            "station"
          ]
        },
        {
          "type": "object",
          "properties": {
            "region": {
              "$ref": "#/$defs/RegionId"
            },
            "scope": {
              "type": "string",
              "const": "region"
            }
          },
          "required": [
            "scope",
            "region"
          ]
        }
      ]
    },
    "FactId": {
      "type": "string",
      "examples": [
        "fact.42"
      ],
      "pattern": "^fact\\.[0-9]+$"
    },
    "Faction": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/FactionId"
        },
        "name": {
          "type": "string"
        },
        "standing": {
          "description": "The player's standing. Shown through how people treat you, not a bar.",
          "type": "integer",
          "format": "int32",
          "default": 0
        },
        "wants": {
          "description": "Wares this faction wants.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/WareId"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ]
    },
    "FactionId": {
      "description": "Stable faction id, e.g. `faction.wharf_cooperative`.",
      "type": "string",
      "examples": [
        "faction.wharf_cooperative"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "FieldId": {
      "description": "Stable field id, e.g. `field.shallows.ice`.",
      "type": "string",
      "examples": [
        "field.shallows.ice"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "FlagId": {
      "description": "Stable flag id, e.g. `flag.nav_chip`.",
      "type": "string",
      "examples": [
        "flag.nav_chip"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "FlyTarget": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "at": {
              "$ref": "#/$defs/Vec2"
            },
            "kind": {
              "type": "string",
              "const": "point"
            }
          },
          "required": [
            "kind",
            "at"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "station"
            },
            "station": {
              "$ref": "#/$defs/StationId"
            }
          },
          "required": [
            "kind",
            "station"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "rock"
            },
            "rock": {
              "$ref": "#/$defs/RockId"
            }
          },
          "required": [
            "kind",
            "rock"
          ]
        },
        {
          "description": "Travel to another region along lanes.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "region"
            },
            "region": {
              "$ref": "#/$defs/RegionId"
            }
          },
          "required": [
            "kind",
            "region"
          ]
        }
      ]
    },
    "Hold": {
      "type": "object",
      "properties": {
        "cargo": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          }
        }
      },
      "required": [
        "cargo"
      ]
    },
    "Hull": {
      "description": "A hull class. Provisional numbers live in the core pack's `hulls.toml`.",
      "type": "object",
      "properties": {
        "hold_capacity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "id": {
          "$ref": "#/$defs/HullId"
        },
        "max_speed": {
          "description": "World units per second at nominal tick rate.",
          "type": "number",
          "format": "float"
        },
        "mining_rate": {
          "description": "Mining units per second at nominal tick rate.",
          "type": "number",
          "format": "float"
        },
        "name": {
          "type": "string"
        },
        "tier": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "tier",
        "hold_capacity",
        "max_speed",
        "mining_rate"
      ]
    },
    "HullId": {
      "description": "Stable hull id, e.g. `hull.wren`.",
      "type": "string",
      "examples": [
        "hull.wren"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "Lane": {
      "description": "A lane between two regions. Gates are world positions at each end.",
      "type": "object",
      "properties": {
        "a": {
          "$ref": "#/$defs/RegionId"
        },
        "a_gate": {
          "$ref": "#/$defs/Vec2"
        },
        "b": {
          "$ref": "#/$defs/RegionId"
        },
        "b_gate": {
          "$ref": "#/$defs/Vec2"
        },
        "id": {
          "$ref": "#/$defs/LaneId"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "a",
        "b",
        "a_gate",
        "b_gate"
      ]
    },
    "LaneId": {
      "description": "Stable lane id, e.g. `lane.shallows_cinder`.",
      "type": "string",
      "examples": [
        "lane.shallows_cinder"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "Market": {
      "description": "A station market as plain data. W3 (economy) owns the maths that moves it.",
      "type": "object",
      "properties": {
        "lines": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$": {
              "$ref": "#/$defs/MarketLine"
            }
          }
        },
        "station": {
          "$ref": "#/$defs/StationId"
        }
      },
      "required": [
        "station",
        "lines"
      ]
    },
    "MarketLine": {
      "description": "One ware at one market. Provisional fields; W3 may extend.",
      "type": "object",
      "properties": {
        "base_price": {
          "description": "Where the price settles with no pressure.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "consumption": {
          "description": "Units the station uses per market step.",
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "max_price": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "min_price": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "price": {
          "description": "Current unit price in credits.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "production": {
          "description": "Units the station makes per market step (W3 defines the step; never a clock).",
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "stock": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "stock",
        "price",
        "base_price",
        "min_price",
        "max_price"
      ]
    },
    "Npc": {
      "type": "object",
      "properties": {
        "faction": {
          "anyOf": [
            {
              "$ref": "#/$defs/FactionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "$ref": "#/$defs/NpcId"
        },
        "location": {
          "description": "Where they can be found.",
          "anyOf": [
            {
              "$ref": "#/$defs/StationId"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "role": {
          "description": "Free-form role, e.g. `dockmaster`, `hullwright`, `scholar`.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "role"
      ]
    },
    "NpcId": {
      "description": "Stable npc id, e.g. `npc.ilse`.",
      "type": "string",
      "examples": [
        "npc.ilse"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "Order": {
      "description": "One order.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "to": {
              "$ref": "#/$defs/FlyTarget"
            },
            "verb": {
              "type": "string",
              "const": "fly"
            }
          },
          "required": [
            "verb",
            "to"
          ]
        },
        {
          "description": "Mine until the hold is full or the rock is depleted.",
          "type": "object",
          "properties": {
            "rock": {
              "$ref": "#/$defs/RockId"
            },
            "verb": {
              "type": "string",
              "const": "mine"
            }
          },
          "required": [
            "verb",
            "rock"
          ]
        },
        {
          "type": "object",
          "properties": {
            "station": {
              "$ref": "#/$defs/StationId"
            },
            "verb": {
              "type": "string",
              "const": "dock"
            }
          },
          "required": [
            "verb",
            "station"
          ]
        },
        {
          "type": "object",
          "properties": {
            "verb": {
              "type": "string",
              "const": "undock"
            }
          },
          "required": [
            "verb"
          ]
        },
        {
          "type": "object",
          "properties": {
            "quantity": {
              "$ref": "#/$defs/Quantity"
            },
            "verb": {
              "type": "string",
              "const": "buy"
            },
            "ware": {
              "$ref": "#/$defs/WareId"
            }
          },
          "required": [
            "verb",
            "ware",
            "quantity"
          ]
        },
        {
          "type": "object",
          "properties": {
            "quantity": {
              "$ref": "#/$defs/Quantity"
            },
            "verb": {
              "type": "string",
              "const": "sell"
            },
            "ware": {
              "$ref": "#/$defs/WareId"
            }
          },
          "required": [
            "verb",
            "ware",
            "quantity"
          ]
        },
        {
          "description": "Wait until a world condition holds (e.g. a price recovers above a floor).",
          "type": "object",
          "properties": {
            "until": {
              "$ref": "#/$defs/Condition"
            },
            "verb": {
              "type": "string",
              "const": "wait"
            }
          },
          "required": [
            "verb",
            "until"
          ]
        },
        {
          "description": "Repeat `orders` until `until` holds, or forever.",
          "type": "object",
          "properties": {
            "orders": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Order"
              }
            },
            "until": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Condition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "verb": {
              "type": "string",
              "const": "loop"
            }
          },
          "required": [
            "verb",
            "orders"
          ]
        }
      ]
    },
    "OrderQueue": {
