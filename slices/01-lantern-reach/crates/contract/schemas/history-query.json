{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HistoryQuery",
  "description": "A history filter. Empty matches everything. `count`, `find` and `last` take one.",
  "type": "object",
  "properties": {
    "after": {
      "description": "Facts with an ID greater than this (for paging).",
      "anyOf": [
        {
          "$ref": "#/$defs/FactId"
        },
        {
          "type": "null"
        }
      ]
    },
    "cause": {
      "anyOf": [
        {
          "$ref": "#/$defs/CauseId"
        },
        {
          "type": "null"
        }
      ]
    },
    "faction": {
      "anyOf": [
        {
          "$ref": "#/$defs/FactionId"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/FactKind"
        },
        {
          "type": "null"
        }
      ]
    },
    "limit": {
      "description": "Most results `find` returns (oldest first).",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "npc": {
      "anyOf": [
        {
          "$ref": "#/$defs/NpcId"
        },
        {
          "type": "null"
        }
      ]
    },
    "other": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnyId"
        },
        {
          "type": "null"
        }
      ]
    },
    "region": {
      "anyOf": [
        {
          "$ref": "#/$defs/RegionId"
        },
        {
          "type": "null"
        }
      ]
    },
    "rock": {
      "anyOf": [
        {
          "$ref": "#/$defs/RockId"
        },
        {
          "type": "null"
        }
      ]
    },
    "ship": {
      "anyOf": [
        {
          "$ref": "#/$defs/ShipId"
        },
        {
          "type": "null"
        }
      ]
    },
    "since": {
      "description": "Facts at or after this tick.",
      "anyOf": [
        {
          "$ref": "#/$defs/Tick"
        },
        {
          "type": "null"
        }
      ]
    },
    "station": {
      "anyOf": [
        {
          "$ref": "#/$defs/StationId"
        },
        {
          "type": "null"
        }
      ]
    },
    "until": {
      "description": "Facts at or before this tick.",
      "anyOf": [
        {
          "$ref": "#/$defs/Tick"
        },
        {
          "type": "null"
        }
      ]
    },
    "ware": {
      "anyOf": [
        {
          "$ref": "#/$defs/WareId"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "AnyId": {
      "description": "Stable entity id, e.g. `quest.ice_for_kettle`.",
      "type": "string",
      "examples": [
        "quest.ice_for_kettle"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "CauseId": {
      "type": "string",
      "examples": [
        "cause.42"
      ],
      "pattern": "^cause\\.[0-9]+$"
    },
    "FactId": {
      "type": "string",
      "examples": [
        "fact.42"
      ],
      "pattern": "^fact\\.[0-9]+$"
    },
    "FactKind": {
      "description": "Stable fact kind id, e.g. `dock`.",
      "type": "string",
      "examples": [
        "dock"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
    },
    "FactionId": {
      "description": "Stable faction id, e.g. `faction.wharf_cooperative`.",
      "type": "string",
      "examples": [
        "faction.wharf_cooperative"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "NpcId": {
      "description": "Stable npc id, e.g. `npc.ilse`.",
      "type": "string",
      "examples": [
        "npc.ilse"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "RegionId": {
      "description": "Stable region id, e.g. `region.lantern_shallows`.",
      "type": "string",
      "examples": [
        "region.lantern_shallows"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "RockId": {
      "description": "Stable rock id, e.g. `rock.shallows.ice.03`.",
      "type": "string",
      "examples": [
        "rock.shallows.ice.03"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "ShipId": {
      "description": "Stable ship id, e.g. `ship.player`.",
      "type": "string",
      "examples": [
        "ship.player"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "StationId": {
      "description": "Stable station id, e.g. `station.kettle_dock`.",
      "type": "string",
      "examples": [
        "station.kettle_dock"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "Tick": {
      "description": "Simulation tick count (30 per second nominal; the sim never reads a clock).",
      "type": "integer",
      "minimum": 0
    },
    "WareId": {
      "description": "Stable ware id, e.g. `ware.ice`.",
      "type": "string",
      "examples": [
        "ware.ice"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    }
  }
}
