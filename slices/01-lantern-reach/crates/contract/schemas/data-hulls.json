{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HullsFile",
  "type": "object",
  "properties": {
    "hull": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Hull"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Hull": {
      "description": "A hull class. Provisional numbers live in the core pack's `hulls.toml`.",
      "type": "object",
      "properties": {
        "hold_capacity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "id": {
          "$ref": "#/$defs/HullId"
        },
        "max_speed": {
          "description": "World units per second at nominal tick rate.",
          "type": "number",
          "format": "float"
        },
        "mining_rate": {
          "description": "Mining units per second at nominal tick rate.",
          "type": "number",
          "format": "float"
        },
        "name": {
          "type": "string"
        },
        "price_reach": {
          "description": "How far the hull sees live market prices. Default: docked only.",
          "$ref": "#/$defs/PriceReach",
          "default": {
            "lane_scout": false,
            "radius": 0.0,
            "region": false
          }
        },
        "tier": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "tier",
        "hold_capacity",
        "max_speed",
        "mining_rate"
      ]
    },
    "HullId": {
      "description": "Stable hull id, e.g. `hull.wren`.",
      "type": "string",
      "examples": [
        "hull.wren"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "PriceReach": {
      "description": "How far a hull sees live prices. The default is \"docked only\".",
      "type": "object",
      "properties": {
        "lane_scout": {
          "description": "A lane arrival refreshes the snapshots of every station in the new region.",
          "type": "boolean",
          "default": false
        },
        "radius": {
          "description": "Live prices of stations within this distance. Zero: docked only.",
          "type": "number",
          "format": "float",
          "default": 0.0
        },
        "region": {
          "description": "Live prices of every station in the ship's region.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    }
  }
}
