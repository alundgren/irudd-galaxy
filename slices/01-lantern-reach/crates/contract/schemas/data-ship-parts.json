{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShipPartsFile",
  "description": "`ship_parts.toml`: the fit model's sockets, wharves, blueprints and mass rules\n(`crate::fit`). The parts themselves are upgrades (`upgrades.toml`).",
  "type": "object",
  "properties": {
    "blueprint": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/BlueprintDef"
      }
    },
    "mass": {
      "$ref": "#/$defs/MassRules",
      "default": {
        "floor": 0.5,
        "speed_per_unit": 0.04,
        "turn_per_unit": 0.06
      }
    },
    "socket": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/SocketDef"
      }
    },
    "wharf": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/WharfDef"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "AnyId": {
      "description": "Stable entity id, e.g. `quest.ice_for_kettle`.",
      "type": "string",
      "examples": [
        "quest.ice_for_kettle"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "BeatId": {
      "description": "Stable beat id, e.g. `beat.first_delivery`.",
      "type": "string",
      "examples": [
        "beat.first_delivery"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "BlueprintDef": {
      "description": "A blueprint found in the world: its flag is set (with a `blueprint_found` fact) the\nfirst time `found` holds. Making its part needs it.",
      "type": "object",
      "properties": {
        "found": {
          "description": "When it's found: activity, history or beats, never time.",
          "$ref": "#/$defs/Requirement"
        },
        "found_in": {
          "description": "Where it turns up, for the log line (\"in the Cinder Belt\").",
          "type": "string"
        },
        "id": {
          "description": "The flag that marks it found (`blueprint.long_drill`).",
          "$ref": "#/$defs/FlagId"
        },
        "name": {
          "description": "\"Long-throw drill blueprint\".",
          "type": "string"
        },
        "part": {
          "$ref": "#/$defs/UpgradeId"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "part",
        "found_in",
        "found"
      ]
    },
    "CauseId": {
      "type": "string",
      "examples": [
        "cause.42"
      ],
      "pattern": "^cause\\.[0-9]+$"
    },
    "CounterKind": {
      "description": "Activity counters. Pacing reads these, never a clock.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "dockings",
            "jumps",
            "sessions",
            "units_mined",
            "rocks_depleted",
            "sales",
            "purchases",
            "scouts",
            "orders_done"
          ]
        },
        {
          "description": "Sales and deliveries, one per transaction.",
          "type": "string",
          "const": "deliveries"
        },
        {
          "description": "Handovers to a ledger (goal deliveries, station growth, dispute tallies).",
          "type": "string",
          "const": "ledger_deliveries"
        }
      ]
    },
    "FactId": {
      "type": "string",
      "examples": [
        "fact.42"
      ],
      "pattern": "^fact\\.[0-9]+$"
    },
    "FactKind": {
      "description": "Stable fact kind id, e.g. `dock`.",
      "type": "string",
      "examples": [
        "dock"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
    },
    "FactionId": {
      "description": "Stable faction id, e.g. `faction.wharf_cooperative`.",
      "type": "string",
      "examples": [
        "faction.wharf_cooperative"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "FlagId": {
      "description": "Stable flag id, e.g. `flag.nav_chip`.",
      "type": "string",
      "examples": [
        "flag.nav_chip"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "HistoryQuery": {
      "description": "A history filter. Empty matches everything. `count`, `find` and `last` take one.",
      "type": "object",
      "properties": {
        "after": {
          "description": "Facts with an ID greater than this (for paging).",
          "anyOf": [
            {
              "$ref": "#/$defs/FactId"
            },
            {
              "type": "null"
            }
          ]
        },
        "cause": {
          "anyOf": [
            {
              "$ref": "#/$defs/CauseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "faction": {
          "anyOf": [
            {
              "$ref": "#/$defs/FactionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/FactKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "description": "Most results `find` returns (oldest first).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "npc": {
          "anyOf": [
            {
              "$ref": "#/$defs/NpcId"
            },
            {
              "type": "null"
            }
          ]
        },
        "other": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnyId"
            },
            {
              "type": "null"
            }
          ]
        },
        "region": {
          "anyOf": [
            {
              "$ref": "#/$defs/RegionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "rock": {
          "anyOf": [
            {
              "$ref": "#/$defs/RockId"
            },
            {
              "type": "null"
            }
          ]
        },
        "ship": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShipId"
            },
            {
              "type": "null"
            }
          ]
        },
        "since": {
          "description": "Facts at or after this tick.",
          "anyOf": [
            {
              "$ref": "#/$defs/Tick"
            },
            {
              "type": "null"
            }
          ]
        },
        "station": {
          "anyOf": [
            {
              "$ref": "#/$defs/StationId"
            },
            {
              "type": "null"
            }
          ]
        },
        "until": {
          "description": "Facts at or before this tick.",
          "anyOf": [
            {
              "$ref": "#/$defs/Tick"
            },
            {
              "type": "null"
            }
          ]
        },
        "ware": {
          "anyOf": [
            {
              "$ref": "#/$defs/WareId"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "HullId": {
      "description": "Stable hull id, e.g. `hull.wren`.",
      "type": "string",
      "examples": [
        "hull.wren"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "MassRules": {
      "description": "How mass past the free allowance slows the hull. Each unit over takes these shares\noff top speed and turn rate, never below `floor`.",
      "type": "object",
      "properties": {
        "floor": {
          "type": "number",
          "format": "double",
          "default": 0.5
        },
        "speed_per_unit": {
          "type": "number",
          "format": "double",
          "default": 0.04
        },
        "turn_per_unit": {
          "type": "number",
          "format": "double",
          "default": 0.06
        }
      },
      "additionalProperties": false
    },
    "NpcId": {
      "description": "Stable npc id, e.g. `npc.ilse`.",
      "type": "string",
      "examples": [
        "npc.ilse"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "Num": {
      "description": "A number, or the current value of a tunable.",
      "anyOf": [
        {
          "type": "number",
          "format": "double"
        },
        {
          "type": "object",
          "properties": {
            "tunable": {
              "$ref": "#/$defs/TunableId"
            }
          },
          "required": [
            "tunable"
          ]
        }
      ]
    },
    "RegionId": {
      "description": "Stable region id, e.g. `region.lantern_shallows`.",
      "type": "string",
      "examples": [
        "region.lantern_shallows"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "Requirement": {
      "description": "A condition over world state, history and activity counters. Never time: there is\nno clock to name. Used by beats, upgrade unlocks and prestige.",
      "oneOf": [
        {
          "description": "Always holds.",
          "type": "string",
          "const": "always"
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Requirement"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "all"
          ]
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Requirement"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "any"
          ]
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/Requirement"
            }
          },
          "additionalProperties": false,
          "required": [
            "not"
          ]
        },
        {
          "type": "object",
          "properties": {
            "beat_done": {
              "$ref": "#/$defs/BeatId"
            }
          },
          "additionalProperties": false,
          "required": [
            "beat_done"
          ]
        },
        {
          "type": "object",
          "properties": {
            "beat_started": {
              "$ref": "#/$defs/BeatId"
            }
          },
          "additionalProperties": false,
          "required": [
            "beat_started"
          ]
        },
        {
          "description": "Started and not completed.",
          "type": "object",
          "properties": {
            "beat_active": {
              "$ref": "#/$defs/BeatId"
            }
          },
          "additionalProperties": false,
          "required": [
            "beat_active"
          ]
        },
        {
          "description": "The beat has reached at least this step (0 = its first step is under way).",
          "type": "object",
          "properties": {
            "beat_step": {
              "type": "object",
              "properties": {
                "at_least": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                },
                "beat": {
                  "$ref": "#/$defs/BeatId"
                }
              },
              "required": [
                "beat",
                "at_least"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "beat_step"
          ]
        },
        {
          "description": "An activity counter for the player, a station or a region.",
          "type": "object",
          "properties": {
            "counter": {
              "type": "object",
              "properties": {
                "at_least": {
                  "$ref": "#/$defs/Num"
                },
                "kind": {
                  "$ref": "#/$defs/CounterKind"
                },
                "region": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/RegionId"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "station": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/StationId"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "kind",
                "at_least"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "counter"
          ]
        },
        {
          "description": "At least `at_least` history facts match (default 1).",
          "type": "object",
          "properties": {
            "facts": {
              "type": "object",
              "properties": {
                "at_least": {
                  "$ref": "#/$defs/Num",
                  "default": 1.0
                },
                "query": {
                  "$ref": "#/$defs/HistoryQuery"
                },
                "since": {
                  "$ref": "#/$defs/Since",
                  "default": "ever"
                }
              },
              "required": [
                "query"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "facts"
          ]
        },
        {
          "description": "The `amount`s of matching facts add up to at least `at_least`.",
          "type": "object",
          "properties": {
            "sum": {
              "type": "object",
              "properties": {
                "at_least": {
                  "$ref": "#/$defs/Num"
                },
                "query": {
                  "$ref": "#/$defs/HistoryQuery"
                },
                "since": {
                  "$ref": "#/$defs/Since",
                  "default": "ever"
                }
              },
              "required": [
                "query",
                "at_least"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "sum"
          ]
        },
        {
          "type": "object",
          "properties": {
            "flag": {
              "$ref": "#/$defs/FlagId"
            }
          },
          "additionalProperties": false,
          "required": [
            "flag"
          ]
        },
        {
          "type": "object",
          "properties": {
            "trait": {
              "$ref": "#/$defs/TraitId"
            }
          },
          "additionalProperties": false,
          "required": [
            "trait"
          ]
        },
        {
          "type": "object",
          "properties": {
            "fitted": {
              "$ref": "#/$defs/UpgradeId"
            }
          },
          "additionalProperties": false,
          "required": [
            "fitted"
          ]
        },
        {
          "description": "The player's ship is this hull.",
          "type": "object",
          "properties": {
            "hull": {
              "$ref": "#/$defs/HullId"
            }
          },
          "additionalProperties": false,
          "required": [
            "hull"
          ]
        },
        {
          "description": "The player owns this craft.",
          "type": "object",
          "properties": {
            "owns": {
              "$ref": "#/$defs/ShipId"
            }
          },
          "additionalProperties": false,
          "required": [
            "owns"
          ]
        },
        {
          "description": "Credits, in centicredits.",
          "type": "object",
          "properties": {
            "credits": {
              "type": "object",
              "properties": {
                "at_least": {
                  "$ref": "#/$defs/Num"
                }
              },
              "required": [
                "at_least"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "credits"
          ]
        },
        {
          "description": "Units of a ware in the player ship's hold.",
          "type": "object",
          "properties": {
            "cargo": {
              "type": "object",
              "properties": {
                "at_least": {
                  "$ref": "#/$defs/Num"
                },
                "ware": {
                  "$ref": "#/$defs/WareId"
                }
              },
              "required": [
                "ware",
                "at_least"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "cargo"
          ]
        },
        {
          "description": "Free room in the player ship's hold.",
          "type": "object",
          "properties": {
            "hold_free": {
              "type": "object",
              "properties": {
                "at_least": {
                  "$ref": "#/$defs/Num"
                }
              },
              "required": [
                "at_least"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "hold_free"
          ]
        },
        {
          "description": "The player ship is docked at this station.",
          "type": "object",
          "properties": {
            "docked_at": {
              "$ref": "#/$defs/StationId"
            }
          },
          "additionalProperties": false,
          "required": [
            "docked_at"
          ]
        },
        {
          "description": "The player ship is docked anywhere.",
          "type": "string",
          "const": "docked"
        },
        {
          "description": "The player ship is in this region.",
          "type": "object",
          "properties": {
            "in_region": {
              "$ref": "#/$defs/RegionId"
            }
          },
          "additionalProperties": false,
          "required": [
            "in_region"
          ]
        },
        {
          "description": "The player ship is in `region`, within `within` u of (`x`, `y`): it went\nsomewhere (a rumored vein, a buoy). Any of the numbers can be a tunable.",
          "type": "object",
          "properties": {
            "near": {
              "type": "object",
              "properties": {
                "region": {
                  "$ref": "#/$defs/RegionId"
                },
                "within": {
                  "$ref": "#/$defs/Num"
                },
                "x": {
                  "$ref": "#/$defs/Num"
                },
                "y": {
                  "$ref": "#/$defs/Num"
                }
              },
              "required": [
                "region",
                "x",
                "y",
                "within"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "near"
          ]
        },
        {
          "description": "The player's regard with a faction is at least this tier (by tier ID).",
          "type": "object",
          "properties": {
            "regard": {
              "type": "object",
              "properties": {
                "at_least": {
                  "type": "string"
                },
                "faction": {
                  "$ref": "#/$defs/FactionId"
                }
              },
              "required": [
                "faction",
                "at_least"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "regard"
          ]
        },
        {
          "description": "A tunable holds this value.",
          "type": "object",
          "properties": {
            "tunable_is": {
              "type": "object",
              "properties": {
                "tunable": {
                  "$ref": "#/$defs/TunableId"
                },
                "value": {
                  "$ref": "#/$defs/TunableValue"
                }
              },
              "required": [
                "tunable",
                "value"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "tunable_is"
          ]
        },
        {
          "description": "A Luau predicate a script registered with `G.test` (by index within its\nscript). Data files can't hold one.",
          "type": "object",
          "properties": {
            "test": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "test"
          ]
        }
      ]
    },
    "RockId": {
      "description": "Stable rock id, e.g. `rock.shallows.ice.03`.",
      "type": "string",
      "examples": [
        "rock.shallows.ice.03"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "ShipId": {
      "description": "Stable ship id, e.g. `ship.player`.",
      "type": "string",
      "examples": [
        "ship.player"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "Since": {
      "description": "Which facts a history requirement counts.",
      "oneOf": [
        {
          "description": "The whole history.",
          "type": "string",
          "const": "ever"
        },
        {
          "description": "Since the beat started (for beat requirements).",
          "type": "string",
          "const": "start"
        },
        {
          "description": "Since the current step started.",
          "type": "string",
          "const": "step"
        }
      ]
    },
    "SocketDef": {
      "description": "A socket kind. A hull has at most one of each.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/SocketId"
        },
        "name": {
          "description": "\"Drill mount\".",
          "type": "string"
        },
        "place": {
          "description": "Where it sits on the hull seen from above, for the cradle and the ship's look:\n`nose`, `utility` (behind the cockpit), `belly`, `tail` or `bay`.",
          "type": "string"
        },
        "rack": {
          "description": "The control rack: holds every control module, uses no budget, and its modules\nare never taken off. Any other socket holds one part.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "place"
      ]
    },
    "SocketId": {
      "description": "Stable socket id, e.g. `socket.drill`.",
      "type": "string",
      "examples": [
        "socket.drill"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "StationId": {
      "description": "Stable station id, e.g. `station.kettle_dock`.",
      "type": "string",
      "examples": [
        "station.kettle_dock"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "Tick": {
      "description": "Simulation tick count (30 per second nominal; the sim never reads a clock).",
      "type": "integer",
      "minimum": 0
    },
    "TraitId": {
      "description": "Stable trait id, e.g. `trait.rich_face`.",
      "type": "string",
      "examples": [
        "trait.rich_face"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "TunableId": {
      "description": "Stable tunable id, e.g. `nav_chip.dockings`.",
      "type": "string",
      "examples": [
        "nav_chip.dockings"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "TunableValue": {
      "anyOf": [
        {
          "type": "number",
          "format": "double"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "UpgradeId": {
      "description": "Stable upgrade id, e.g. `upgrade.mining_lens`.",
      "type": "string",
      "examples": [
        "upgrade.mining_lens"
      ],
      "maxLength": 128,
