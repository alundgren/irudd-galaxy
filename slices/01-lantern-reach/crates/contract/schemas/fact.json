{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fact",
  "description": "One entry in the history log.",
  "type": "object",
  "properties": {
    "amount": {
      "description": "A quantity for summing (units mined, sold, delivered ...).",
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "cause": {
      "$ref": "#/$defs/CauseId"
    },
    "id": {
      "$ref": "#/$defs/FactId"
    },
    "kind": {
      "$ref": "#/$defs/FactKind"
    },
    "payload": {
      "$ref": "#/$defs/FactPayload"
    },
    "subjects": {
      "$ref": "#/$defs/Subjects"
    },
    "tick": {
      "$ref": "#/$defs/Tick"
    }
  },
  "required": [
    "id",
    "tick",
    "kind",
    "cause",
    "subjects",
    "payload"
  ],
  "$defs": {
    "AnyId": {
      "description": "Stable entity id, e.g. `quest.ice_for_kettle`.",
      "type": "string",
      "examples": [
        "quest.ice_for_kettle"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "CauseId": {
      "type": "string",
      "examples": [
        "cause.42"
      ],
      "pattern": "^cause\\.[0-9]+$"
    },
    "Event": {
      "description": "Something that happened, with stable IDs.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ship": {
              "$ref": "#/$defs/ShipId"
            },
            "station": {
              "$ref": "#/$defs/StationId"
            },
            "type": {
              "type": "string",
              "const": "dock"
            }
          },
          "required": [
            "type",
            "ship",
            "station"
          ]
        },
        {
          "type": "object",
          "properties": {
            "ship": {
              "$ref": "#/$defs/ShipId"
            },
            "station": {
              "$ref": "#/$defs/StationId"
            },
            "type": {
              "type": "string",
              "const": "undock"
            }
          },
          "required": [
            "type",
            "ship",
            "station"
          ]
        },
        {
          "description": "Units moved from a rock into a hold.",
          "type": "object",
          "properties": {
            "amount": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "rock": {
              "$ref": "#/$defs/RockId"
            },
            "ship": {
              "$ref": "#/$defs/ShipId"
            },
            "type": {
              "type": "string",
              "const": "mine"
            },
            "ware": {
              "$ref": "#/$defs/WareId"
            }
          },
          "required": [
            "type",
            "ship",
            "rock",
            "ware",
            "amount"
          ]
        },
        {
          "type": "object",
          "properties": {
            "rock": {
              "$ref": "#/$defs/RockId"
            },
            "ship": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ShipId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "rock_depleted"
            }
          },
          "required": [
            "type",
            "rock"
          ]
        },
        {
          "type": "object",
          "properties": {
            "quantity": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "ship": {
              "$ref": "#/$defs/ShipId"
            },
            "station": {
              "$ref": "#/$defs/StationId"
            },
            "type": {
              "type": "string",
              "const": "buy"
            },
            "unit_price": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "ware": {
              "$ref": "#/$defs/WareId"
            }
          },
          "required": [
            "type",
            "ship",
            "station",
            "ware",
            "quantity",
            "unit_price"
          ]
        },
        {
          "type": "object",
          "properties": {
            "quantity": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "ship": {
              "$ref": "#/$defs/ShipId"
            },
            "station": {
              "$ref": "#/$defs/StationId"
            },
            "type": {
              "type": "string",
              "const": "sell"
            },
            "unit_price": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "ware": {
              "$ref": "#/$defs/WareId"
            }
          },
          "required": [
            "type",
            "ship",
            "station",
            "ware",
            "quantity",
            "unit_price"
          ]
        },
        {
          "description": "Cargo handed over for a goal or a station's growth, not sold.",
          "type": "object",
          "properties": {
            "quantity": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "ship": {
              "$ref": "#/$defs/ShipId"
            },
            "station": {
              "$ref": "#/$defs/StationId"
            },
            "type": {
              "type": "string",
              "const": "deliver"
            },
            "ware": {
              "$ref": "#/$defs/WareId"
            }
          },
          "required": [
            "type",
            "ship",
            "station",
            "ware",
            "quantity"
          ]
        },
        {
          "type": "object",
          "properties": {
            "from": {
              "$ref": "#/$defs/RegionId"
            },
            "lane": {
              "$ref": "#/$defs/LaneId"
            },
            "ship": {
              "$ref": "#/$defs/ShipId"
            },
            "to": {
              "$ref": "#/$defs/RegionId"
            },
            "type": {
              "type": "string",
              "const": "jump"
            }
          },
          "required": [
            "type",
            "ship",
            "lane",
            "from",
            "to"
          ]
        },
        {
          "description": "A price snapshot was taken at a station.",
          "type": "object",
          "properties": {
            "ship": {
              "$ref": "#/$defs/ShipId"
            },
            "station": {
              "$ref": "#/$defs/StationId"
            },
            "type": {
              "type": "string",
              "const": "scout"
            }
          },
          "required": [
            "type",
            "ship",
            "station"
          ]
        },
        {
          "type": "object",
          "properties": {
            "ship": {
              "$ref": "#/$defs/ShipId"
            },
            "type": {
              "type": "string",
              "const": "order_done"
            },
            "verb": {
              "$ref": "#/$defs/VerbKind"
            }
          },
          "required": [
            "type",
            "ship",
            "verb"
          ]
        },
        {
          "type": "object",
          "properties": {
            "quest": {
              "$ref": "#/$defs/QuestId"
            },
            "step": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "quest_step"
            }
          },
          "required": [
            "type",
            "quest",
            "step"
          ]
        },
        {
          "type": "object",
          "properties": {
            "trait_id": {
              "$ref": "#/$defs/TraitId"
            },
            "type": {
              "type": "string",
              "const": "trait_earned"
            }
          },
          "required": [
            "type",
            "trait_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "from_hull": {
              "$ref": "#/$defs/HullId"
            },
            "to_hull": {
              "$ref": "#/$defs/HullId"
            },
            "type": {
              "type": "string",
              "const": "prestige"
            }
          },
          "required": [
            "type",
            "from_hull",
            "to_hull"
          ]
        },
        {
          "description": "A play session began (the app emits it when the game starts).",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "session_start"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "FactId": {
      "type": "string",
      "examples": [
        "fact.42"
      ],
      "pattern": "^fact\\.[0-9]+$"
    },
    "FactKind": {
      "description": "Stable fact kind id, e.g. `dock`.",
      "type": "string",
      "examples": [
        "dock"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
    },
    "FactPayload": {
      "oneOf": [
        {
          "description": "The event this fact records.",
          "type": "object",
          "properties": {
            "event": {
              "$ref": "#/$defs/Event"
            }
          },
          "additionalProperties": false,
          "required": [
            "event"
          ]
        },
        {
          "description": "A recorded fact of a pack's own kind, with a short note.",
          "type": "object",
          "properties": {
            "note": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "note"
          ]
        }
      ]
    },
    "FactionId": {
      "description": "Stable faction id, e.g. `faction.wharf_cooperative`.",
      "type": "string",
      "examples": [
        "faction.wharf_cooperative"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "HullId": {
      "description": "Stable hull id, e.g. `hull.wren`.",
      "type": "string",
      "examples": [
        "hull.wren"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "LaneId": {
      "description": "Stable lane id, e.g. `lane.shallows_cinder`.",
      "type": "string",
      "examples": [
        "lane.shallows_cinder"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "NpcId": {
      "description": "Stable npc id, e.g. `npc.ilse`.",
      "type": "string",
      "examples": [
        "npc.ilse"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "QuestId": {
      "description": "Stable quest id, e.g. `quest.ice_for_kettle`.",
      "type": "string",
      "examples": [
        "quest.ice_for_kettle"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "RegionId": {
      "description": "Stable region id, e.g. `region.lantern_shallows`.",
      "type": "string",
      "examples": [
        "region.lantern_shallows"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "RockId": {
      "description": "Stable rock id, e.g. `rock.shallows.ice.03`.",
      "type": "string",
      "examples": [
        "rock.shallows.ice.03"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "ShipId": {
      "description": "Stable ship id, e.g. `ship.player`.",
      "type": "string",
      "examples": [
        "ship.player"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "StationId": {
      "description": "Stable station id, e.g. `station.kettle_dock`.",
      "type": "string",
      "examples": [
        "station.kettle_dock"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "Subjects": {
      "description": "The indexed subjects of a fact. Every field is optional; queries match on any\ncombination. Add a field here (and a column in the save's `history` table) to\nindex a new kind of subject.",
      "type": "object",
      "properties": {
        "faction": {
          "anyOf": [
            {
              "$ref": "#/$defs/FactionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "npc": {
          "anyOf": [
            {
              "$ref": "#/$defs/NpcId"
            },
            {
              "type": "null"
            }
          ]
        },
        "other": {
          "description": "Any other entity (a quest, trait, hull, lane, rumor ...).",
          "anyOf": [
            {
              "$ref": "#/$defs/AnyId"
            },
            {
              "type": "null"
            }
          ]
        },
        "region": {
          "anyOf": [
            {
              "$ref": "#/$defs/RegionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "rock": {
          "anyOf": [
            {
              "$ref": "#/$defs/RockId"
            },
            {
              "type": "null"
            }
          ]
        },
        "ship": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShipId"
            },
            {
              "type": "null"
            }
          ]
        },
        "station": {
          "anyOf": [
            {
              "$ref": "#/$defs/StationId"
            },
            {
              "type": "null"
            }
          ]
        },
        "ware": {
          "anyOf": [
            {
              "$ref": "#/$defs/WareId"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Tick": {
      "description": "Simulation tick count (30 per second nominal; the sim never reads a clock).",
      "type": "integer",
      "minimum": 0
    },
    "TraitId": {
      "description": "Stable trait id, e.g. `trait.rich_face`.",
      "type": "string",
      "examples": [
        "trait.rich_face"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "VerbKind": {
      "description": "Verb names, used in causes and `order_done` events.",
      "type": "string",
      "enum": [
        "fly",
        "mine",
        "dock",
        "undock",
        "buy",
        "sell",
        "wait",
        "loop"
      ]
    },
    "WareId": {
      "description": "Stable ware id, e.g. `ware.ice`.",
      "type": "string",
      "examples": [
        "ware.ice"
      ],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    }
  }
}
