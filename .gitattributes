# Text files are stored and checked out with LF on every OS, whatever core.autocrlf
# says, so tests and generated files see the same bytes everywhere. Folders can
# override this in their own .gitattributes.
* text=auto eol=lf

# Windows launch scripts need CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.ogg binary
*.wav binary
*.mp3 binary
*.flac binary
*.zip binary
*.sqlite binary
